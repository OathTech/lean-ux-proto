{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:leanux:observation:v1",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,80}$"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "ret": {
            "type": "integer",
            "minimum": -4095,
            "maximum": 9223372036854775807
          },
          "errno": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 4095
              }
            ]
          },
          "bytes": {
            "type": "string",
            "pattern": "^([0-9a-f]{2}){0,16}$"
          }
        },
        "required": [
          "index",
          "ret",
          "errno",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "branches": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "index",
          "label"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "id",
    "observations",
    "branches"
  ],
  "additionalProperties": false,
  "$comment": "Evaluator checks exact operation counts, indices, errno and output-byte consistency against input."
}
