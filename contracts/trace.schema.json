{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:leanux:trace:v1",
  "$defs": {
    "fd": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "literal": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          },
          "required": [
            "literal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ref": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            }
          },
          "required": [
            "ref"
          ],
          "additionalProperties": false,
          "$comment": "Names an earlier eventfd2, dup, dup3 or epoll_create1."
        },
        {
          "type": "object",
          "properties": {
            "pipe": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "end": {
              "enum": [
                0,
                1
              ]
            }
          },
          "required": [
            "pipe",
            "end"
          ],
          "additionalProperties": false,
          "$comment": "End 0 (fd[0], the read end) or 1 (fd[1], the write end) of an earlier pipe2."
        }
      ]
    },
    "pause_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "$comment": "The guest sleeps this long before the operation's coverage reset; the mirror ignores it (P design section 6)."
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 69632,
      "$comment": "MAX_IO: 17 pages (P design section 6)."
    }
  },
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,80}$"
    },
    "ops": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "eventfd2"
              },
              "init": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "flags": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "pause_ms": {
                "$ref": "#/$defs/pause_ms"
              }
            },
            "required": [
              "op",
              "init",
              "flags"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "pipe2"
              },
              "flags": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "pause_ms": {
                "$ref": "#/$defs/pause_ms"
              }
            },
            "required": [
              "op",
              "flags"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "dup"
              },
              "fd": {
                "$ref": "#/$defs/fd"
              },
              "pause_ms": {
                "$ref": "#/$defs/pause_ms"
              }
            },
            "required": [
              "op",
              "fd"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "dup3"
              },
              "fd": {
                "$ref": "#/$defs/fd"
              },
              "newfd": {
                "$ref": "#/$defs/fd"
              },
              "flags": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "pause_ms": {
                "$ref": "#/$defs/pause_ms"
              }
            },
            "required": [
              "op",
              "fd",
              "newfd",
              "flags"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "close"
              },
              "fd": {
                "$ref": "#/$defs/fd"
              },
              "pause_ms": {
                "$ref": "#/$defs/pause_ms"
              }
            },
            "required": [
              "op",
              "fd"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "read"
              },
              "fd": {
                "$ref": "#/$defs/fd"
              },
              "count": {
                "$ref": "#/$defs/count"
              },
              "pause_ms": {
                "$ref": "#/$defs/pause_ms"
              }
            },
            "required": [
              "op",
              "fd",
              "count"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "write"
              },
              "fd": {
                "$ref": "#/$defs/fd"
              },
              "count": {
                "$ref": "#/$defs/count"
              },
              "value": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              },
              "pause_ms": {
                "$ref": "#/$defs/pause_ms"
              }
            },
            "required": [
              "op",
              "fd",
              "count",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "epoll_create1"
              },
              "flags": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "pause_ms": {
                "$ref": "#/$defs/pause_ms"
              }
            },
            "required": [
              "op",
              "flags"
            ],
            "additionalProperties": false,
            "$comment": "epoll (amended 2026-10-12): a descriptor producer."
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "epoll_ctl"
              },
              "epfd": {
                "$ref": "#/$defs/fd"
              },
              "cmd": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "fd": {
                "$ref": "#/$defs/fd"
              },
              "events": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "data": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$",
                "$comment": "A canonical unsigned 64-bit decimal string, like a write's value."
              },
              "pause_ms": {
                "$ref": "#/$defs/pause_ms"
              }
            },
            "required": [
              "op",
              "epfd",
              "cmd",
              "fd",
              "events",
              "data"
            ],
            "additionalProperties": false,
            "$comment": "epoll (amended 2026-10-12): cmd 1 ADD, 2 DEL, 3 MOD; any other value is observable as -EINVAL."
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "epoll_wait"
              },
              "epfd": {
                "$ref": "#/$defs/fd"
              },
              "maxevents": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "timeout": {
                "const": 0
              },
              "pause_ms": {
                "$ref": "#/$defs/pause_ms"
              }
            },
            "required": [
              "op",
              "epfd",
              "maxevents",
              "timeout"
            ],
            "additionalProperties": false,
            "$comment": "epoll (amended 2026-10-12), tier 1: 1-16 events, timeout 0; other values are unsupported, not invalid."
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "fcntl"
              },
              "fd": {
                "$ref": "#/$defs/fd"
              },
              "cmd": {
                "enum": [
                  "F_GETFD",
                  "F_SETFD",
                  "F_GETFL",
                  "F_SETFL",
                  "F_SETPIPE_SZ",
                  "F_GETPIPE_SZ"
                ]
              },
              "arg": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "pause_ms": {
                "$ref": "#/$defs/pause_ms"
              }
            },
            "required": [
              "op",
              "fd",
              "cmd",
              "arg"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "rlimit_nofile": {
      "type": "integer",
      "minimum": 8,
      "maximum": 1024,
      "$comment": "RLIMIT_NOFILE set by the fixture before the first operation; default 32"
    }
  },
  "required": [
    "version",
    "id",
    "ops"
  ],
  "additionalProperties": false,
  "$comment": "Additional normative range, reference, reserved-FD, NONBLOCK, pipes and epoll rules are in trace-v1.md. This schema covers the FD, eventfd, pipe and epoll operations; the WireGuard operations (wg_*) and the steering fields (steer, expect) are specified by harness/trace.py and harness/wg.py, not here."
}
