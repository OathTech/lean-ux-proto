+/*
+ * LEANUX PROBE (docs/2026-10-03-choice-stream-strategy.md, section 10 step 0;
+ * not for the oracle): every generic random and clock call in a recording
+ * context, and every remote section's start and stop, with a global
+ * sequence number. Coverage mode only: a header word (KCOV_PROBE_MAGIC in
+ * the top 16 bits, the requested length in bits 32-47, the kind in bits
+ * 16-31, the payload words in bits 0-15), the call site, the sequence
+ * number, then up to 40 payload bytes.
+ */
+#define KCOV_PROBE_MAGIC 0x4c59ULL
+static atomic64_t kcov_probe_seq;
+
+void notrace kcov_probe_ip(u32 kind, unsigned long ip, const void *data, unsigned int len)
+{
+	struct task_struct *t = current;
+	const u8 *bytes = data;
+	u64 words[5] = {0};
+	unsigned int n = len > 40 ? 40 : len, nwords = DIV_ROUND_UP(n, 8), i;
+	u64 *area, pos;
+
+	if (!check_kcov_mode(KCOV_MODE_TRACE_PC, t))
+		return;
+	for (i = 0; i < n; i++)
+		words[i / 8] |= (u64)bytes[i] << (8 * (i % 8));
+	area = (u64 *)t->kcov_area;
+	pos = READ_ONCE(area[0]);
+	if (pos + 3 + nwords >= t->kcov_size) {
+		WRITE_ONCE(area[0], t->kcov_size - 1);
+		return;
+	}
+	WRITE_ONCE(area[0], pos + 3 + nwords);
+	barrier();
+	area[pos + 1] = KCOV_PROBE_MAGIC << 48 | (u64)(len & 0xffff) << 32 |
+			(u64)(kind & 0xffff) << 16 | nwords;
+	area[pos + 2] = canonicalize_ip(ip);
+	area[pos + 3] = atomic64_inc_return(&kcov_probe_seq);
+	for (i = 0; i < nwords; i++)
+		area[pos + 4 + i] = words[i];
+}
+EXPORT_SYMBOL(kcov_probe_ip);
