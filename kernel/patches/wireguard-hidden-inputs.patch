+/*
+ * LEANUX: record a hidden input (a random draw, a clock read) at its source,
+ * so the Lean mirror can consume it (docs/2026-10-03-hidden-inputs-design.md).
+ * The record goes into the active KCOV area, under the same context test as
+ * coverage, so it follows the per-operation reset and the remote-section copy.
+ * KCOV_MODE_TRACE_PC: a header word (KCOV_HIDDEN_MAGIC in the top 16 bits,
+ * never a kernel address), the call site, then the payload words.
+ * KCOV_MODE_TRACE_CMP: a header record (type bit 63 and KCOV_HIDDEN_MAGIC,
+ * arg1 = call site), then records of three payload words (KCOV_HIDDEN_MAGIC+1).
+ * A record that does not fit marks the area full, so the harness fails
+ * noisily instead of losing a value.
+ */
+#define KCOV_HIDDEN_MAGIC 0x4c58ULL
+#define KCOV_HIDDEN_MAX_WORDS 8
+
+void notrace kcov_record(u32 site, const void *data, unsigned int len)
+{
+	struct task_struct *t = current;
+	unsigned long ip = canonicalize_ip(_RET_IP_);
+	const u8 *bytes = data;
+	u64 words[KCOV_HIDDEN_MAX_WORDS + 2] = {0};
+	unsigned int nwords = DIV_ROUND_UP(len, 8), i;
+	u64 *area;
+
+	if (WARN_ON_ONCE(nwords > KCOV_HIDDEN_MAX_WORDS))
+		return;
+	for (i = 0; i < len; i++)
+		words[i / 8] |= (u64)bytes[i] << (8 * (i % 8));
+	if (check_kcov_mode(KCOV_MODE_TRACE_PC, t)) {
+		u64 pos;
+
+		area = (u64 *)t->kcov_area;
+		pos = READ_ONCE(area[0]);
+		if (pos + 2 + nwords >= t->kcov_size) {
+			WRITE_ONCE(area[0], t->kcov_size - 1);
+			return;
+		}
+		WRITE_ONCE(area[0], pos + 2 + nwords);
+		barrier();
+		area[pos + 1] = KCOV_HIDDEN_MAGIC << 48 | (u64)(site & 0xffff) << 16 | nwords;
+		area[pos + 2] = ip;
+		for (i = 0; i < nwords; i++)
+			area[pos + 3 + i] = words[i];
+	} else if (IS_ENABLED(CONFIG_KCOV_ENABLE_COMPARISONS) &&
+		   check_kcov_mode(KCOV_MODE_TRACE_CMP, t)) {
+		u64 count, start, nrec = 1 + DIV_ROUND_UP(nwords, 3), r;
+
+		area = (u64 *)t->kcov_area;
+		count = READ_ONCE(area[0]);
+		start = 1 + count * KCOV_WORDS_PER_CMP;
+		if ((start + nrec * KCOV_WORDS_PER_CMP) * sizeof(u64) >
+		    t->kcov_size * sizeof(unsigned long)) {
+			WRITE_ONCE(area[0], (t->kcov_size - 1) / KCOV_WORDS_PER_CMP);
+			return;
+		}
+		WRITE_ONCE(area[0], count + nrec);
+		barrier();
+		area[start] = 1ULL << 63 | KCOV_HIDDEN_MAGIC << 32 | (u64)(site & 0xffff) << 16 | nwords;
+		area[start + 1] = ip;
+		area[start + 2] = 0;
+		area[start + 3] = ip;
+		for (r = 0; r + 1 < nrec; r++) {
+			u64 *rec = area + start + (r + 1) * KCOV_WORDS_PER_CMP;
+
+			rec[0] = 1ULL << 63 | (KCOV_HIDDEN_MAGIC + 1) << 32 | r;
+			rec[1] = words[3 * r];
+			rec[2] = words[3 * r + 1];
+			rec[3] = words[3 * r + 2];
+		}
+	}
+}
+EXPORT_SYMBOL(kcov_record);
