import Leanux.Kernel.Defs

/-!
# kernel/signal.c — signal generation, down to the pending set

`send_sig` → `send_sig_info` → `do_send_sig_info` → `send_signal_locked` →
`__send_signal_locked` (with `prepare_signal`, `sig_ignored`, `legacy_queue`,
`__sigqueue_alloc`, `complete_signal`, `wants_signal`), as `pipe_write`
reaches it for `SIGPIPE` (fs/pipe.c:458, 499). User decision Q3 of the P
design (docs/2026-10-05-p-pipes.md section 6, decision P9): mirror the chain
down to the pending set.

The target `t` is a `TaskRef` (the interface commit of the seccomp design,
docs/2026-10-12-seccomp-design.md 4.1, audit M2): the trace process, which
every caller on the pipe paths passes (`current` there is the one task), or
the sandboxed child of a child probe, which the seccomp paths pass through
`Kernel.current`. Mirrored state: `t->blocked` and `t->pending.signal`. Shape deviation (design section 2): the
`sigqueue` list of `t->pending` is not mirrored (only `legacy_queue` reads
the pending set, and nothing in stage 1 dequeues), so the queued entry's
`siginfo` is not either. Cut points, each stated at its call:
`lock_task_sighand` (the task is live: it is `current` or its child),
`inc_rlimit_get_ucounts`/`dec_rlimit_put_ucounts` (kernel/ucount.c),
`signalfd_notify` (no signalfd waiters), `task_pid_nr_ns`,
`from_kuid_munged`, `trace_signal_generate`.

seccomp stream V (docs/2026-10-12-seccomp-design.md 2.2, 4.5; the P9
widening before the user as section 16): the arms an unblocked `SIGSYS`
takes, generated by `force_sig_seccomp` with a handler (`TRAP`) or forced
to the default (a kill): `sig_task_ignored` past the ptrace test with the
`SIGSYS` disposition, the real `siginfo` in `__send_signal_locked` (its
three fields travel as the `trapped` outcome, the queue entry still not a
list), `wants_signal`'s unblocked arms, `complete_signal`'s wake arm with
the `sig_fatal` chain, `signal_wake_up_state`, and `force_sig_info_to_task`.
Delivery (`get_signal`, the handler frame, `rt_sigreturn`) is an
environment effect (`Env.trapDelivered`).

Paths outside the stage (`unsupported`): the disposition of any other
unblocked signal, stop and continue signals, shared or process-group
delivery, real-time signals, a second thread.
-/

namespace Leanux

/-- Signal numbers (arch/x86/include/uapi/asm/signal.h) and limits. -/
def SIGKILL : Nat := 9
def SIGCONT : Nat := 18
def SIGSYS : Nat := 31
/-- `SYS_SECCOMP` (include/uapi/asm-generic/siginfo.h), `si_code` of a
    seccomp `SIGSYS`: positive, so `__sigqueue_alloc` overrides the rlimit. -/
def SYS_SECCOMP : Int := 1
/-- `enum sig_handler` (kernel/signal.c:1322-1326): `HANDLER_CURRENT` 0,
    `HANDLER_SIG_DFL` 1, `HANDLER_EXIT` 2. -/
def HANDLER_CURRENT : Nat := 0
def HANDLER_EXIT : Nat := 2

/-- `sigdelset`. -/
def sigdelset (s : SigSet) (sig : Nat) : SigSet := s &&& ~~~(sigmask sig)
def SIGRTMIN : Nat := 32
/-- `_NSIG` (arch/x86/include/asm/signal.h). -/
def NSIG : Nat := 64

/-- `enum pid_type` (include/linux/pid_types.h): PIDTYPE_PID = 0,
    PIDTYPE_TGID = 1, ... -/
def PIDTYPE_PID : Nat := 0
def PIDTYPE_TGID : Nat := 1

/-- The `info` argument: `SEND_SIG_NOINFO` (`(struct kernel_siginfo *) 0`) or
    `SEND_SIG_PRIV` (`1`), the two special values (`is_si_special`), or the
    real `siginfo` `force_sig_seccomp` builds (signal.c:1855-1868): `SIGSYS`,
    `SYS_SECCOMP`, `si_errno` = the filter's data, `si_syscall`, `si_arch`. -/
inductive SigInfo where
  | noinfo | priv
  | sys (nr : Int) (errno : Int) (arch : UInt32)
  deriving Repr, BEq

/-- `is_si_special(info)`. -/
def SigInfo.isSpecial : SigInfo → Bool
  | .noinfo | .priv => true
  | .sys .. => false

/-- `sig_kernel_stop(sig)` (include/linux/signal.h): `sig < SIGRTMIN` and `sig`
    in `SIG_KERNEL_STOP_MASK` = {SIGSTOP 19, SIGTSTP 20, SIGTTIN 21,
    SIGTTOU 22}. A value, not a mirrored choice point of its own. -/
def sigKernelStop (sig : Nat) : Bool := sig < SIGRTMIN && [19, 20, 21, 22].contains sig

#guard [19, 20, 21, 22].all sigKernelStop && !sigKernelStop SIGPIPE && !sigKernelStop SIGCONT

/-- __sigqueue_alloc (kernel/signal.c:404-442). `inc_rlimit_get_ucounts` is a
    cut point with the contract: the per-user pending count after the
    increment, nonzero (no overflow). Its value is not observable to the
    mirror: the condition at 425 is the cut's outcome. Returns whether a
    `sigqueue` was allocated (`q != NULL`). -/
def sigqueueAlloc (overrideRlimit : Nat) : M Bool := do
  -- rcu_read_lock(); ucounts = task_ucounts(t); sigpending = inc_rlimit_get_ucounts(...)
  let sigpendingNonzero := true  -- the cut's contract
  if ← branch .sigqueueAllocNoUcounts (!sigpendingNonzero) then return false
  -- `override_rlimit || likely(sigpending <= task_rlimit(t, RLIMIT_SIGPENDING))`
  let q ← do
    if ← branchCmp .sigqueueAllocOverride (overrideRlimit != 0) overrideRlimit 0 then
      envOk .sigqueueAlloc  -- kmem_cache_alloc(sigqueue_cachep, gfp_flags)
    else
      unsupported "__sigqueue_alloc without override_rlimit (RLIMIT_SIGPENDING)"
  if ← branch .sigqueueAllocNull (!q) then
    pure ()  -- dec_rlimit_put_ucounts: a cut
  -- else INIT_LIST_HEAD(&q->list); q->flags; q->ucounts (the list is not mirrored)
  return q

/-- `sig_kernel_ignore(sig)`: `SIG_KERNEL_IGNORE_MASK` = {SIGCONT 18, SIGCHLD 17,
    SIGWINCH 28, SIGURG 23} (include/linux/signal.h:434-436). -/
def sigKernelIgnore (sig : Nat) : Bool := [17, 18, 23, 28].contains sig

/-- `sig_kernel_coredump(sig)`: `SIG_KERNEL_COREDUMP_MASK` (include/linux/signal.h:426-432),
    SIGSYS included. -/
def sigKernelCoredump (sig : Nat) : Bool := [3, 4, 5, 6, 8, 11, 7, 31, 24, 25].contains sig

/-- The disposition the signal paths read for `sig` of the target `tk`: only
    `SIGSYS`'s is mirrored (`Task.sigsys`; design 4.1). -/
def sigDisposition (tk : Task) (sig : Nat) : M SigDisposition := do
  if sig == SIGSYS then return tk.sigsys
  unsupported s!"the disposition of signal {sig} is not mirrored (only SIGSYS's)"

/-- sig_handler_ignored (kernel/signal.c:75-80): `handler == SIG_IGN ||
    (handler == SIG_DFL && sig_kernel_ignore(sig))`, one returned expression. -/
def sigHandlerIgnored (disp : SigDisposition) (sig : Nat) : M Bool := do
  -- no mirrored disposition is SIG_IGN (the guest installs the handler at setup)
  if ← branch .sigHandlerIgn false then return true
  branch .sigHandlerDflIgnore (disp != .handler && sigKernelIgnore sig)

/-- sig_task_ignored (kernel/signal.c:82-102), for the target `t`: not init,
    not `SIGNAL_UNKILLABLE`, not a kthread on these paths. -/
def sigTaskIgnored (t : TaskRef) (sig : Nat) (_force : Bool) : M Bool := do
  let tk ← getTask t
  let disp ← sigDisposition tk sig
  -- `is_global_init(t) && sig_kernel_only(sig)`: the trace process is not init
  if ← branch .sigTaskIgnoredGlobalInit false then return true
  -- `(t->signal->flags & SIGNAL_UNKILLABLE) && ...`: never set here
  if ← branch .sigTaskIgnoredUnkillable false then return true
  -- `(t->flags & PF_KTHREAD) && ...`
  if ← branch .sigTaskIgnoredKthread tk.isKthread then return true
  sigHandlerIgnored disp sig

/-- sig_ignored (kernel/signal.c:104-123), for the target `t`.
    `t->real_blocked` is empty (it is set only inside `sigtimedwait`). -/
def sigIgnored (t : TaskRef) (sig : Nat) (force : Bool := false) : M Bool := do
  let tk ← getTask t
  -- `sigismember(&t->blocked, sig) || sigismember(&t->real_blocked, sig)`
  let blocked ← do
    if ← branch .sigIgnoredBlocked (sigismember tk.blocked sig) then pure true
    else branch .sigIgnoredRealBlocked (sigismember (0 : SigSet) sig)
  if blocked then return false
  -- `t->ptrace && sig != SIGKILL`: the trace child is not traced
  if ← branch .sigIgnoredPtrace false then return false
  sigTaskIgnored t sig force

/-- prepare_signal (kernel/signal.c:902-967), for the target `t`. -/
def prepareSignal (t : TaskRef) (sig : Nat) (force : Bool := false) : M Bool := do
  -- `signal->flags & SIGNAL_GROUP_EXIT`: the trace child is not exiting
  if ← branch .prepareSignalGroupExit false then
    unsupported "prepare_signal: a group exit in progress"
  else if ← branch .prepareSignalStop (sigKernelStop sig) then
    unsupported "prepare_signal: a stop signal"
  else if ← branchCmp .prepareSignalCont (sig == SIGCONT) sig SIGCONT then
    unsupported "prepare_signal: SIGCONT"
  return !(← sigIgnored t sig force)

/-- legacy_queue (kernel/signal.c:1068-1071) on `t->pending`. -/
def legacyQueue (pending : SigSet) (sig : Nat) : M Bool := do
  if ← branchCmp .legacyQueueNotRt (sig < SIGRTMIN) sig SIGRTMIN then
    branch .legacyQueuePending (sigismember pending sig)
  else return false

/-- wants_signal (kernel/signal.c:977-992), for the target `t`. `PF_EXITING`
    is clear at generation on these paths (`Task.exited` tracks the later
    `exit_task_work`, false while the task issues calls); the target is
    `current`, so `task_curr(p)` holds and `task_sigpending` is not read. -/
def wantsSignal (t : TaskRef) (sig : Nat) : M Bool := do
  let tk ← getTask t
  if ← branch .wantsSignalBlocked (sigismember tk.blocked sig) then return false
  if ← branch .wantsSignalExiting tk.exited then return false
  if ← branchCmp .wantsSignalSigkill (sig == SIGKILL) sig SIGKILL then return true
  -- `task_is_stopped_or_traced(p)`: the target is running
  if ← branch .wantsSignalStopped false then return false
  -- `task_curr(p) || !task_sigpending(p)`: one line, one body
  if ← branch .wantsSignalCurr ((← getK).current == t) then return true
  branch .wantsSignalNotPending (!tk.sigpending)

/-- signal_wake_up_state (kernel/signal.c:759-774), for the target `t`:
    `TIF_SIGPENDING`; `wake_up_state` on a running task fails and
    `kick_process` is a cut (one CPU: nothing to kick). -/
def signalWakeUpState (t : TaskRef) : M Unit := do
  modifyTask t fun tk => { tk with sigpending := true }
  if ← branch .wakeUpStateFailed true then pure ()

/-- `sig_fatal(t, sig)` (include/linux/signal.h:451-453): not ignored or stop
    by the kernel, and the disposition is `SIG_DFL`. -/
def sigFatal (disp : SigDisposition) (sig : Nat) : Bool :=
  !(sigKernelIgnore sig || sigKernelStop sig) && disp != .handler

/-- complete_signal (kernel/signal.c:994-1066), for the target `t`: the one
    thread is woken when it wants the signal; a fatal signal of the coredump
    class (`SIGSYS`) skips the group-exit block and is woken like any other
    (`do_coredump` and the exit run at delivery, an environment effect). -/
def completeSignal (t : TaskRef) (sig : Nat) (type : Nat) : M Unit := do
  if ← branch .completeSignalWants (← wantsSignal t sig) then
    -- t = p
    let tk ← getTask t
    let disp ← sigDisposition tk sig
    -- `sig_fatal(p, sig) && (core_state || !(flags & SIGNAL_GROUP_EXIT)) &&
    -- !sigismember(&t->real_blocked, sig) && (sig == SIGKILL || !p->ptrace)` over four lines
    let fatal ← do
      if !(← branch .completeSignalFatal (sigFatal disp sig)) then pure false
      else if !(← branch .completeSignalNoGroupExit true) then pure false
      else if !(← branch .completeSignalNotRealBlocked true) then pure false
      -- `sig == SIGKILL` here is the compiler's common subexpression of wants_signal's (measured)
      else if ← branch .completeSignalSigkill (sig == SIGKILL) then pure true
      else branch .completeSignalNotPtraced true
    if fatal then
      if ← branch .completeSignalNotCoredump (!sigKernelCoredump sig) then
        unsupported "complete_signal: a fatal non-coredump signal (the group exit)"
    -- signal_wake_up(t, sig == SIGKILL)
    signalWakeUpState t
    return
  -- `(type == PIDTYPE_PID) || thread_group_empty(p)`
  if ← branchCmp .completeSignalPidType (type == PIDTYPE_PID) type PIDTYPE_PID then
    return  -- one thread, which does not need to be woken
  unsupported "complete_signal: thread_group_empty (group delivery)"

/-- __send_signal_locked (kernel/signal.c:1073-1188), with `t->sighand->siglock`
    held, for the target `t`. Returns `ret` (0, or -EAGAIN on a queue
    overflow). -/
def sendSignalLocked' (t : TaskRef) (sig : Nat) (info : SigInfo) (type : Nat) (force : Bool) : M Int := do
  -- result = TRACE_SIGNAL_IGNORED
  if ← branch .sendSignalNotPrepared !(← prepareSignal t sig force) then return 0
  -- `pending = (type != PIDTYPE_PID) ? &t->signal->shared_pending : &t->pending`
  if ← branchCmp .sendSignalShared (type != PIDTYPE_PID) type PIDTYPE_PID then
    unsupported "__send_signal_locked: shared_pending"
  -- result = TRACE_SIGNAL_ALREADY_PENDING
  if ← branch .sendSignalLegacy (← legacyQueue (← getTask t).pending sig) then return 0
  -- result = TRACE_SIGNAL_DELIVERED
  -- `(sig == SIGKILL) || (t->flags & PF_KTHREAD)`
  let skip ← do
    if ← branchCmp .sendSignalSigkill (sig == SIGKILL) sig SIGKILL then pure true
    else branch .sendSignalKthread (← getTask t).isKthread
  if !skip then
    let overrideRlimit : Nat ← do
      if ← branch .sendSignalNotRt (sig < SIGRTMIN) then
        -- `is_si_special(info) || info->si_code >= 0`: one line, assigned
        if ← branch .sendSignalSiSpecial info.isSpecial then pure 1
        else if ← branchCmp .sendSignalSiCodeNonneg (SYS_SECCOMP ≥ 0) SYS_SECCOMP 0 then pure 1
        else pure 0
      else pure 0
    let q ← sigqueueAlloc overrideRlimit
    if ← branch .sendSignalQueued q then
      -- list_add_tail(&q->list, &pending->list): the list is not mirrored
      match info with
      | .noinfo =>
        -- si_signo, si_errno, si_code = SI_USER, si_pid, si_uid: not mirrored
        _ ← branch .sendSignalNoinfo true
      | .priv => _ ← branch .sendSignalPrivInfo true
      | .sys .. =>
        -- copy_siginfo(&q->info, info): the entry is not mirrored; the fields
        -- travel as the `trapped` outcome (design 4.5)
        _ ← branch .sendSignalCopyInfo true
    else
      -- `!is_si_special(info) && sig >= SIGRTMIN && info->si_code != SI_USER`
      if ← branch .sendSignalOverflowNotSpecial false then
        unsupported "__send_signal_locked: a real-time queue overflow"
      -- result = TRACE_SIGNAL_LOSE_INFO
  -- out_set: signalfd_notify(t, sig) is a cut (no signalfd waiters)
  modifyTask t fun tk => { tk with pending := sigaddset tk.pending sig }
  if ← branchCmp .sendSignalMultiprocess (type > PIDTYPE_TGID) type PIDTYPE_TGID then
    unsupported "__send_signal_locked: multiprocess signals"
  completeSignal t sig type
  -- ret: trace_signal_generate (a tracepoint, compiled to a static branch)
  return 0

/-- send_signal_locked (kernel/signal.c:1214-1252). `force` for
    `SEND_SIG_NOINFO` is `!task_pid_nr_ns(current, ...)`, an assignment (not
    a choice point): the trace child's pid is nonzero, so `false`. -/
def sendSignalLocked (t : TaskRef) (sig : Nat) (info : SigInfo) (type : Nat) : M Int := do
  let force ← do
    if ← branch .sendSignalLockedNoinfo (info == .noinfo) then
      pure false  -- force = !task_pid_nr_ns(current, task_active_pid_ns(t))
    else if ← branch .sendSignalLockedPriv (info == .priv) then pure true
    -- `has_si_pid_and_uid(info)`: a `SYS_SECCOMP` siginfo has the SIL_SYS layout, no ids
    else if ← branch .sendSignalLockedHasPidUid false then
      unsupported "send_signal_locked: a siginfo with pid and uid"
    else pure false
  sendSignalLocked' t sig info type force

/-- do_send_sig_info (kernel/signal.c:1297-1309). `lock_task_sighand` is a cut
    point: the target is live (`current`, or the child inside its probe), so
    it succeeds. -/
def doSendSigInfo (t : TaskRef) (sig : Nat) (info : SigInfo) (type : Nat) : M Int := do
  let mut ret : Int := -3  -- -ESRCH
  if ← branch .doSendSigLock true then
    ret ← sendSignalLocked t sig info type
    -- unlock_task_sighand
  return ret

/-- send_sig_info (kernel/signal.c:1656-1666) to the target `t`. -/
def sendSigInfo (t : TaskRef) (sig : Nat) (info : SigInfo) : M Int := do
  -- `!valid_signal(sig)`: `sig <= _NSIG` (include/linux/signal.h:274)
  if ← branchCmp .sendSigInfoInvalid (!(sig <= NSIG)) sig NSIG then return -EINVAL
  doSendSigInfo t sig info PIDTYPE_PID

/-- send_sig (kernel/signal.c:1672-1676) to the target `t` (`current` on
    the pipe paths: `.task`). -/
def sendSig (t : TaskRef) (sig : Nat) (priv : Nat) : M Int := do
  -- `__si_special(priv)`: `priv ? SEND_SIG_PRIV : SEND_SIG_NOINFO`
  let info : SigInfo := if ← branchCmp .sendSigPriv (priv != 0) priv 0 then .priv else .noinfo
  sendSigInfo t sig info

/-- force_sig_info_to_task (kernel/signal.c:1328-1363), for the target `t`
    with `handler` `HANDLER_CURRENT` (0) or `HANDLER_EXIT` (2). `ignored` is
    false (no mirrored disposition is `SIG_IGN`); `SIGNAL_UNKILLABLE` is not
    mirrored (never set); `lock_task_sighand` is a cut (the target is live). -/
def forceSigInfoToTask (info : SigInfo) (t : TaskRef) (handler : Nat) : M Int := do
  let sig ← match info with
    | .sys .. => pure SIGSYS
    | _ => unsupported "force_sig_info_to_task: a signal other than seccomp's SIGSYS"
  let tk ← getTask t
  let ignored := false
  let blocked := sigismember tk.blocked sig
  -- `blocked || ignored || (handler != HANDLER_CURRENT)`: one line, one body
  let reset ← do
    if ← branch .forceSigBlocked blocked then pure true
    else if ← branch .forceSigIgnored ignored then pure true
    else branchCmp .forceSigNotCurrent (handler != HANDLER_CURRENT) handler HANDLER_CURRENT
  if reset then
    modifyTask t fun tk => { tk with sigsys := .dfl }
    if ← branchCmp .forceSigHandlerExit (handler == HANDLER_EXIT) handler HANDLER_EXIT then
      modifyTask t fun tk => { tk with sigsys := .dflImmutable }
    if ← branch .forceSigWasBlocked blocked then
      modifyTask t fun tk => { tk with blocked := sigdelset tk.blocked sig }
  -- `action->sa.sa_handler == SIG_DFL && (!t->ptrace || (handler == HANDLER_EXIT))`
  let disp := (← getTask t).sigsys
  if ← branch .forceSigActionDfl (disp != .handler) then
    if ← branch .forceSigNotPtraced true then
      pure ()  -- t->signal->flags &= ~SIGNAL_UNKILLABLE: not mirrored
  let ret ← sendSignalLocked t sig info PIDTYPE_PID
  -- `!task_sigpending(t)`: complete_signal woke the task (TIF_SIGPENDING set)
  if ← branch .forceSigNotPending (!(← getTask t).sigpending) then
    signalWakeUpState t  -- signal_wake_up(t, 0)
  return ret

/-- `AUDIT_ARCH_X86_64` (include/uapi/linux/audit.h), `syscall_get_arch`. -/
def AUDIT_ARCH_X86_64 : UInt32 := 0xc000003e

/-- force_sig_seccomp (kernel/signal.c:1855-1868) to `current`: the `SIGSYS`
    siginfo with `SYS_SECCOMP`, the filter's data as `si_errno`, the call
    number and the architecture; `HANDLER_EXIT` when a core dump is forced. -/
def forceSigSeccomp (syscall data : Int) (forceCoredump : Bool) : M Int := do
  let t := (← getK).current
  forceSigInfoToTask (.sys syscall data AUDIT_ARCH_X86_64) t (if forceCoredump then HANDLER_EXIT else HANDLER_CURRENT)

end Leanux
