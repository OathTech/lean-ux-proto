import Leanux.Proofs.WG.AuthenticatedEffects.StagedCompleteReachedStagingPrimitiveReservePoints

/-! Child call contexts are generated by the fixed staging witness. A right
context retains the actual successful left prefix; a receipt context saves
its original capture entry. Substitution is a consequence, not provenance. -/
namespace Leanux.Proofs.WG.AuthenticatedEffects.StagedEntry.Reached.StagingComposition
open Leanux Leanux.WG Leanux.Proofs.Logged TransmitSecurity CausalJournal
open Staged.Obligations Staging.Points StagingPhase
set_option maxHeartbeats 600000

inductive Call : {α β : Type} → {action : WGPrefix Event α} → {body : WGPrefix Event β} →
    Shape action → WGWorld → Ambient → List Event → Child body → WGWorld → Ambient → List Event →
    (WGPrefix Event β → WGPrefix Event α) → Type 1 where
  | here (token : Child body) : Call (.child token) w a h token w a h id
  | left {body : WGPrefix Event α} {next : α → WGPrefix Event β} {head : Shape body}
      (tail : ∀ value,Shape (next value)) (call : Call head w a h token v b middle context) :
      Call (.bind head tail) w a h token v b middle (fun rest=>context rest >>= next)
  | right {body : WGPrefix Event α} {next : α → WGPrefix Event β} (head : Shape body)
      (tail : ∀ value,Shape (next value))
      (leading : runWGPrefix body w a h=(.ok ((value,u),c),prior))
      (call : Call (tail value) u c prior token v b middle context) :
      Call (.bind head tail) w a h token v b middle context
  | receipt (record : WGRunWitness α → Event) (call : Call shape w a h token v b middle context) :
      Call (.receipt record shape) w a h token v b middle
        (fun rest=>savedReceipt record w a (context rest))
  | marked (label : Label) (call : Call shape w a h token v b middle context) :
      Call (.marked label shape) w a h token v b middle context

theorem Call.entry {shape : Shape action} (call : Call shape w a h token v b middle context)
    (covered : Covers E shape w a h) : E middle v b := by
  induction call with
  | here=>exact covered.1
  | left tail call ih=>exact ih covered.1
  | right head tail leading call ih=>exact ih (covered.2 _ _ _ _ leading)
  | receipt record call ih=>exact ih covered.1
  | marked label call ih=>exact ih covered

theorem Call.resume {shape : Shape action} {token : Child body}
    (call : Call shape w a h token v b middle context)
    (child : runWGPrefix body v b middle=runWGPrefix rest u c last) :
    runWGPrefix action w a h=runWGPrefix (context rest) u c last := by
  induction call with
  | here=>exact child
  | left tail call ih=>rw [run_bind,run_bind,ih child]
  | right head tail leading call ih=>rw [run_bind,leading]; exact ih child
  | receipt record call ih=>
    simp only [savedReceipt,runWGPrefix_receiptWGObserved]
    rw [ih child]
  | marked label call ih=>exact ih child

end Leanux.Proofs.WG.AuthenticatedEffects.StagedEntry.Reached.StagingComposition
