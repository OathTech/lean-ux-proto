import Leanux.Proofs.WG.AuthenticatedEffects.StagedCompleteReachedStagingPhaseCertified
import Leanux.Proofs.WG.AuthenticatedEffects.StagedEntryKeyFrames
import Leanux.Proofs.WG.AuthenticatedEffects.StagedCompleteReachedStagingPrimitiveIndexSource

/-! Literal key-repayment source points include the device/key lookup guards,
owner-word dereference, index membership decision and table writeback. A point
is generated by the original finite bind tree and successful leading runs;
no factorization can introduce a new point. Ambient failures retain the entry
cut and no error world. -/
namespace Leanux.Proofs.WG.AuthenticatedEffects.StagedEntry.Reached.StagingPrimitive
open Leanux Leanux.WG Leanux.Proofs.Logged Lifetimes TransmitSecurity CausalJournal
set_option maxHeartbeats 600000

inductive KeyAtom : Type → Type 1 where
  | world : KeyAtom WGWorld
  | ambient (body : AmbientM α) : KeyAtom α
  | table (entries : List IndexEntry) : KeyAtom Unit
  | branch (site : Leanux.Decision) (flag : Bool) : KeyAtom Bool
  | compare (site : Leanux.Decision) (flag : Bool) (left right : Int) : KeyAtom Bool
  | read (kid : KeypairId) : KeyAtom Keypair
  | write (kid : KeypairId) (key : Keypair) : KeyAtom Unit
  | owner (kid : KeypairId) : KeyAtom PeerId
  | unhash (kid : KeypairId) : KeyAtom Unit
  | erase (kid : KeypairId) : KeyAtom Unit
  | failed (α : Type) (message : String) : KeyAtom α
  | unsupported (α : Type) (message : String) : KeyAtom α

def KeyAtom.action : KeyAtom α → WG.M α
  | .world=>get
  | .ambient body=>monadLift body
  | .table entries=>modifyDev fun d=>{d with indexTable:=entries}
  | .branch site flag=>Leanux.branch site flag
  | .compare site flag left right=>branchCmp site flag left right
  | .read kid=>getKeypair kid
  | .write kid key=>setKeypair kid key
  | .owner kid=>IndexOwner.peerDeref (.keypair kid)
  | .unhash kid=>liftIndex (indexRemove (.keypair kid))
  | .erase kid=>modifyDev fun d=>{d with keypairs:=d.keypairs.erase kid}
  | .failed _ message=>invariant message
  | .unsupported _ message=>Leanux.unsupported message

inductive KeyShape : {α : Type} → WG.M α → Type 1 where
  | pure (value : α) : KeyShape (pure value)
  | atom (token : KeyAtom α) : KeyShape token.action
  | bind {body : WG.M α} {next : α → WG.M β}
      (head : KeyShape body) (tail : ∀ value,KeyShape (next value)) : KeyShape (body >>= next)

def branchShape (site : Leanux.Decision) (flag : Bool) : KeyShape (Leanux.branch site flag) := .atom (.branch site flag)
def compareShape (site : Leanux.Decision) (flag : Bool) (left right : Int) : KeyShape (branchCmp site flag left right) := .atom (.compare site flag left right)
def deviceShape : KeyShape getDev := by
  unfold getDev
  apply KeyShape.bind (.atom .world)
  intro w
  cases w.dev with
  | none=>exact .atom (.failed _ "no WireGuard device in this trace's fixture")
  | some d=>exact .pure d

def readShape (kid : KeypairId) : KeyShape (getKeypair kid) := by
  unfold getKeypair
  apply KeyShape.bind deviceShape
  intro d
  cases d.keypairs.get? kid with
  | none=>exact .atom (.failed _ s!"dangling keypair {kid}")
  | some key=>exact .pure key
def peerShape (pid : PeerId) : KeyShape (getPeer pid) := by
  unfold getPeer
  apply KeyShape.bind deviceShape
  intro d
  cases d.peers.get? pid with
  | none=>exact .atom (.failed _ s!"dangling peer {pid}")
  | some peer=>exact .pure peer
def writeShape (kid : KeypairId) (key : Keypair) : KeyShape (setKeypair kid key) := .atom (.write kid key)
def ownerShape (kid : KeypairId) : KeyShape (IndexOwner.peerDeref (.keypair kid)) := by
  unfold IndexOwner.peerDeref IndexOwner.peerWord
  apply KeyShape.bind (.bind (readShape kid) (fun key=>.pure key.peer))
  intro peer
  cases peer with
  | none=>exact .atom (.unsupported _ "entry->peer is NULL: the C dereferences it")
  | some pid=>exact .pure pid
def unhashShape (kid : KeypairId) : KeyShape (liftIndex (indexRemove (.keypair kid))) := by
  rw [unhash_factor]
  unfold unhashNative
  exact .bind deviceShape (fun d=>
    .bind (.atom (.branch .idxRemoveHashed (d.indexTable.any (·.owner == .keypair kid))))
      (fun _=>.atom (.table (d.indexTable.filter fun e=>!(e.owner == .keypair kid)))))
def eraseShape (kid : KeypairId) : KeyShape (modifyDev fun d=>{d with keypairs:=d.keypairs.erase kid}) := .atom (.erase kid)
def failedShape (α : Type) (message : String) : KeyShape (invariant message : WG.M α) := .atom (.failed α message)
def unsupportedShape (α : Type) (message : String) : KeyShape (unsupported message : WG.M α) := .atom (.unsupported α message)

noncomputable def keyShape (kid : Option KeypairId) : KeyShape (keypairPut kid false) := by
  unfold keypairPut refcountDecAndTest
  repeat' first
    | exact branchShape _ _
    | exact compareShape _ _ _ _
    | exact readShape _
    | exact writeShape _ _
    | exact ownerShape _
    | exact unhashShape _
    | exact eraseShape _
    | exact failedShape _ _
    | exact unsupportedShape _ _
    | exact KeyShape.pure _
    | apply KeyShape.bind
    | intro value
    | split

inductive KeyPoint : {α β : Type} → {action : WG.M α} →
    KeyShape action → WGWorld → Ambient → WG.M β → WGWorld → Ambient → WG.M α → Type 1 where
  | entry (shape : KeyShape action) : KeyPoint shape w a action w a action
  | returned (shape : KeyShape action) (run : (action.run w).run a=.ok ((value,v),b)) :
      KeyPoint shape w a (pure value) v b (pure value)
  | left {body : WG.M α} {next : α → WG.M β} {head : KeyShape body}
      (tail : ∀ value,KeyShape (next value)) (point : KeyPoint head w a leaf v b rest) :
      KeyPoint (.bind head tail) w a leaf v b (rest >>= next)
  | right {body : WG.M α} {next : α → WG.M β} (head : KeyShape body)
      (tail : ∀ value,KeyShape (next value))
      (leading : (body.run w).run a=.ok ((value,u),c))
      (point : KeyPoint (tail value) u c leaf v b rest) :
      KeyPoint (.bind head tail) w a leaf v b rest

theorem KeyPoint.residual {action : WG.M α} {shape : KeyShape action} (point : KeyPoint shape w a leaf v b rest) :
    (action.run w).run a=(rest.run v).run b := by
  induction point with
  | entry=>rfl
  | returned shape run=>exact run
  | left tail point ih=>
    simp only [StateT.run_bind]
    rw [ih]
  | right head tail leading point ih=>
    simp only [StateT.run_bind]
    rw [leading]
    exact ih

theorem KeyPoint.stopped {action : WG.M α} {shape : KeyShape action} (point : KeyPoint shape w a leaf v b rest)
    (failed : (rest.run v).run b=.error reason) : (action.run w).run a=.error reason :=
  point.residual.trans failed

end Leanux.Proofs.WG.AuthenticatedEffects.StagedEntry.Reached.StagingPrimitive
