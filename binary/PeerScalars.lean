import Layouts
import Memory
set_option maxRecDepth 4096
set_option maxHeartbeats 200000
namespace Binary
-- Generated by binary/generate.py from DWARF; field interpretation in peer_layouts.py.
/-- Stable scalar and byte-array peer fields. This is one component,
    not a complete peer relation: pointer structures, queues, timers,
    refcount and the owning embedded entry have separate equations.
    serialWorkCpu none denotes NR_CPUS = 1 in this image (cpumask.h).
    No cryptographic field here is treated as an opaque placeholder. -/
structure PeerStableFields (m : Mem 64) (a : BitVec 64) (p : Leanux.WG.Peer) : Prop where
  persistentKeepaliveInterval : m.loadInt (a + .ofNat 64 1036) 2 = some (p.persistentKeepaliveInterval : Int)
  isDead : m.loadInt (a + .ofNat 64 132) 1 = some (if p.isDead then 1 else 0)
  serialWorkCpu : m.loadInt (a + .ofNat 64 128) 4 = some (p.serialWorkCpu.getD 1 : Int)
  internalId : m.loadInt (a + .ofNat 64 1512) 8 = some (p.internalId : Int)
  lastSentHandshake : m.loadInt (a + .ofNat 64 552) 8 = some (p.lastSentHandshake.toBitVec.toNat : Int)
  txBytes : m.loadInt (a + .ofNat 64 824) 8 = some (p.txBytes : Int)
  rxBytes : m.loadInt (a + .ofNat 64 816) 8 = some (p.rxBytes : Int)
  walltimeLastHandshake : m.loadBytes (a + .ofNat 64 1040) 16 = some p.walltimeLastHandshake
  timerHandshakeAttempts : m.loadInt (a + .ofNat 64 1032) 4 = some (p.timerHandshakeAttempts : Int)
  timerNeedAnotherKeepalive : m.loadInt (a + .ofNat 64 1038) 1 = some (if p.timerNeedAnotherKeepalive then 1 else 0)
  sentLastminuteHandshake : m.loadInt (a + .ofNat 64 1039) 1 = some (if p.sentLastminuteHandshake then 1 else 0)
  remoteStatic : m.loadBytes (a + .ofNat 64 312) 32 = some p.remoteStatic
  presharedKey : m.loadBytes (a + .ofNat 64 408) 32 = some p.presharedKey
  precomputedStaticStatic : m.loadBytes (a + .ofNat 64 376) 32 = some p.precomputedStaticStatic
  lastInitiationConsumption : m.loadInt (a + .ofNat 64 264) 8 = some (p.lastInitiationConsumption.toBitVec.toNat : Int)
  handshakeState : m.loadInt (a + .ofNat 64 256) 4 = some (p.handshakeState : Int)
  latestTimestamp : m.loadBytes (a + .ofNat 64 504) 12 = some p.latestTimestamp
  remoteIndex : m.loadInt (a + .ofNat 64 516) 4 = some (p.remoteIndex : Int)
  ephemeralPrivate : m.loadBytes (a + .ofNat 64 280) 32 = some p.ephemeralPrivate
  remoteEphemeral : m.loadBytes (a + .ofNat 64 344) 32 = some p.remoteEphemeral
  chainingKey : m.loadBytes (a + .ofNat 64 472) 32 = some p.chainingKey
  hash : m.loadBytes (a + .ofNat 64 440) 32 = some p.hash
  cookieMac1Key : m.loadBytes (a + .ofNat 64 730) 32 = some p.cookieMac1Key
  lastMac1Sent : m.loadBytes (a + .ofNat 64 682) 16 = some p.lastMac1Sent
  haveSentMac1 : m.loadInt (a + .ofNat 64 681) 1 = some (if p.haveSentMac1 then 1 else 0)
  cookieDecryptionKey : m.loadBytes (a + .ofNat 64 698) 32 = some p.cookieDecryptionKey
  cookie : m.loadBytes (a + .ofNat 64 665) 16 = some p.cookie
  cookieBirthdate : m.loadInt (a + .ofNat 64 656) 8 = some (p.cookieBirthdate.toBitVec.toNat : Int)
  cookieIsValid : m.loadInt (a + .ofNat 64 664) 1 = some (if p.cookieIsValid then 1 else 0)

def peerStableOffsets : List (Nat × Nat) :=
  [(1036, 2), (132, 1), (128, 4), (1512, 8), (552, 8), (824, 8), (816, 8), (1040, 16), (1032, 4), (1038, 1), (1039, 1), (312, 32), (408, 32), (376, 32), (264, 8), (256, 4), (504, 12), (516, 4), (280, 32), (344, 32), (472, 32), (440, 32), (730, 32), (682, 16), (681, 1), (698, 32), (665, 16), (656, 8), (664, 1)]

def peerStableLocations (a : BitVec 64) : List (BitVec 64 × Nat) :=
  peerStableOffsets.map (fun cell => (a + .ofNat 64 cell.1, cell.2))


private theorem stable_loadInt {before after : Mem 64} {writes : BitVec 64 → Prop}
    (a : BitVec 64) (same : EqualOutside writes before after)
    (separate : ∀ location ∈ peerStableLocations a, ∀ i < location.2,
      ¬writes (location.1 + .ofNat 64 i))
    (off size : Nat) (member : (off, size) ∈ peerStableOffsets) :
    before.loadInt (a + .ofNat 64 off) size = after.loadInt (a + .ofNat 64 off) size := by
  apply EqualOutside.loadInt same
  exact separate _ (List.mem_map_of_mem (f := fun cell : Nat × Nat =>
    (a + .ofNat 64 cell.1, cell.2)) member)

private theorem stable_loadBytes {before after : Mem 64} {writes : BitVec 64 → Prop}
    (a : BitVec 64) (same : EqualOutside writes before after)
    (separate : ∀ location ∈ peerStableLocations a, ∀ i < location.2,
      ¬writes (location.1 + .ofNat 64 i))
    (off size : Nat) (member : (off, size) ∈ peerStableOffsets) :
    before.loadBytes (a + .ofNat 64 off) size = after.loadBytes (a + .ofNat 64 off) size := by
  apply EqualOutside.loadBytes same
  exact separate _ (List.mem_map_of_mem (f := fun cell : Nat × Nat =>
    (a + .ofNat 64 cell.1, cell.2)) member)

/-- Frame only the represented reads, permitting the separate
    refcount and embedded-entry peer word to change. -/
theorem PeerStableFields.frame {before after : Mem 64} {writes : BitVec 64 → Prop}
    {a : BitVec 64} {p : Leanux.WG.Peer}
    (same : EqualOutside writes before after)
    (separate : ∀ location ∈ peerStableLocations a, ∀ i < location.2,
      ¬writes (location.1 + .ofNat 64 i))
    (represented : PeerStableFields before a p) : PeerStableFields after a p := by
  refine { persistentKeepaliveInterval := ?_, isDead := ?_, serialWorkCpu := ?_, internalId := ?_, lastSentHandshake := ?_, txBytes := ?_, rxBytes := ?_, walltimeLastHandshake := ?_, timerHandshakeAttempts := ?_, timerNeedAnotherKeepalive := ?_, sentLastminuteHandshake := ?_, remoteStatic := ?_, presharedKey := ?_, precomputedStaticStatic := ?_, lastInitiationConsumption := ?_, handshakeState := ?_, latestTimestamp := ?_, remoteIndex := ?_, ephemeralPrivate := ?_, remoteEphemeral := ?_, chainingKey := ?_, hash := ?_, cookieMac1Key := ?_, lastMac1Sent := ?_, haveSentMac1 := ?_, cookieDecryptionKey := ?_, cookie := ?_, cookieBirthdate := ?_, cookieIsValid := ?_ }
  · exact (stable_loadInt a same separate 1036 2 (by decide)).symm.trans represented.persistentKeepaliveInterval
  · exact (stable_loadInt a same separate 132 1 (by decide)).symm.trans represented.isDead
  · exact (stable_loadInt a same separate 128 4 (by decide)).symm.trans represented.serialWorkCpu
  · exact (stable_loadInt a same separate 1512 8 (by decide)).symm.trans represented.internalId
  · exact (stable_loadInt a same separate 552 8 (by decide)).symm.trans represented.lastSentHandshake
  · exact (stable_loadInt a same separate 824 8 (by decide)).symm.trans represented.txBytes
  · exact (stable_loadInt a same separate 816 8 (by decide)).symm.trans represented.rxBytes
  · exact (stable_loadBytes a same separate 1040 16 (by decide)).symm.trans represented.walltimeLastHandshake
  · exact (stable_loadInt a same separate 1032 4 (by decide)).symm.trans represented.timerHandshakeAttempts
  · exact (stable_loadInt a same separate 1038 1 (by decide)).symm.trans represented.timerNeedAnotherKeepalive
  · exact (stable_loadInt a same separate 1039 1 (by decide)).symm.trans represented.sentLastminuteHandshake
  · exact (stable_loadBytes a same separate 312 32 (by decide)).symm.trans represented.remoteStatic
  · exact (stable_loadBytes a same separate 408 32 (by decide)).symm.trans represented.presharedKey
  · exact (stable_loadBytes a same separate 376 32 (by decide)).symm.trans represented.precomputedStaticStatic
  · exact (stable_loadInt a same separate 264 8 (by decide)).symm.trans represented.lastInitiationConsumption
  · exact (stable_loadInt a same separate 256 4 (by decide)).symm.trans represented.handshakeState
  · exact (stable_loadBytes a same separate 504 12 (by decide)).symm.trans represented.latestTimestamp
  · exact (stable_loadInt a same separate 516 4 (by decide)).symm.trans represented.remoteIndex
  · exact (stable_loadBytes a same separate 280 32 (by decide)).symm.trans represented.ephemeralPrivate
  · exact (stable_loadBytes a same separate 344 32 (by decide)).symm.trans represented.remoteEphemeral
  · exact (stable_loadBytes a same separate 472 32 (by decide)).symm.trans represented.chainingKey
  · exact (stable_loadBytes a same separate 440 32 (by decide)).symm.trans represented.hash
  · exact (stable_loadBytes a same separate 730 32 (by decide)).symm.trans represented.cookieMac1Key
  · exact (stable_loadBytes a same separate 682 16 (by decide)).symm.trans represented.lastMac1Sent
  · exact (stable_loadInt a same separate 681 1 (by decide)).symm.trans represented.haveSentMac1
  · exact (stable_loadBytes a same separate 698 32 (by decide)).symm.trans represented.cookieDecryptionKey
  · exact (stable_loadBytes a same separate 665 16 (by decide)).symm.trans represented.cookie
  · exact (stable_loadInt a same separate 656 8 (by decide)).symm.trans represented.cookieBirthdate
  · exact (stable_loadInt a same separate 664 1 (by decide)).symm.trans represented.cookieIsValid

theorem PeerStableFields.refcount_update (m : Mem 64) (a : BitVec 64)
    (p : Leanux.WG.Peer) (count : Nat) :
    PeerStableFields m a {p with refcount := count} ↔ PeerStableFields m a p := by
  constructor
  · intro h; exact {persistentKeepaliveInterval := h.persistentKeepaliveInterval, isDead := h.isDead, serialWorkCpu := h.serialWorkCpu, internalId := h.internalId, lastSentHandshake := h.lastSentHandshake, txBytes := h.txBytes, rxBytes := h.rxBytes, walltimeLastHandshake := h.walltimeLastHandshake, timerHandshakeAttempts := h.timerHandshakeAttempts, timerNeedAnotherKeepalive := h.timerNeedAnotherKeepalive, sentLastminuteHandshake := h.sentLastminuteHandshake, remoteStatic := h.remoteStatic, presharedKey := h.presharedKey, precomputedStaticStatic := h.precomputedStaticStatic, lastInitiationConsumption := h.lastInitiationConsumption, handshakeState := h.handshakeState, latestTimestamp := h.latestTimestamp, remoteIndex := h.remoteIndex, ephemeralPrivate := h.ephemeralPrivate, remoteEphemeral := h.remoteEphemeral, chainingKey := h.chainingKey, hash := h.hash, cookieMac1Key := h.cookieMac1Key, lastMac1Sent := h.lastMac1Sent, haveSentMac1 := h.haveSentMac1, cookieDecryptionKey := h.cookieDecryptionKey, cookie := h.cookie, cookieBirthdate := h.cookieBirthdate, cookieIsValid := h.cookieIsValid}
  · intro h; exact {persistentKeepaliveInterval := h.persistentKeepaliveInterval, isDead := h.isDead, serialWorkCpu := h.serialWorkCpu, internalId := h.internalId, lastSentHandshake := h.lastSentHandshake, txBytes := h.txBytes, rxBytes := h.rxBytes, walltimeLastHandshake := h.walltimeLastHandshake, timerHandshakeAttempts := h.timerHandshakeAttempts, timerNeedAnotherKeepalive := h.timerNeedAnotherKeepalive, sentLastminuteHandshake := h.sentLastminuteHandshake, remoteStatic := h.remoteStatic, presharedKey := h.presharedKey, precomputedStaticStatic := h.precomputedStaticStatic, lastInitiationConsumption := h.lastInitiationConsumption, handshakeState := h.handshakeState, latestTimestamp := h.latestTimestamp, remoteIndex := h.remoteIndex, ephemeralPrivate := h.ephemeralPrivate, remoteEphemeral := h.remoteEphemeral, chainingKey := h.chainingKey, hash := h.hash, cookieMac1Key := h.cookieMac1Key, lastMac1Sent := h.lastMac1Sent, haveSentMac1 := h.haveSentMac1, cookieDecryptionKey := h.cookieDecryptionKey, cookie := h.cookie, cookieBirthdate := h.cookieBirthdate, cookieIsValid := h.cookieIsValid}

#print axioms PeerStableFields.frame
#print axioms PeerStableFields.refcount_update

def peerHandshakePeerOffset : Nat := 224
/-- The mutable refcount and embedded handshake peer word are
    disjoint from every represented stable field, by DWARF offsets. -/
theorem peerStable_mutable_disjoint (a : BitVec 64) (location : BitVec 64 × Nat)
    (present : location ∈ peerStableLocations a) (i : Nat) (hi : i < location.2) :
    ¬(InRange (a + .ofNat 64 1056) 4 (location.1 + .ofNat 64 i) ∨
      InRange (a + .ofNat 64 224) 8 (location.1 + .ofNat 64 i)) := by
  obtain ⟨cell, member, rfl⟩ := List.mem_map.mp present
  let safe (p : Nat × Nat) : Prop := p.1+p.2 ≤ 1520 ∧
    (p.1+p.2 ≤ 1056 ∨ 1060 ≤ p.1) ∧
    (p.1+p.2 ≤ 224 ∨ 232 ≤ p.1)
  have checked : peerStableOffsets.all (fun p => decide (safe p)) = true := by decide
  have facts : safe cell := of_decide_eq_true (List.all_eq_true.mp checked cell member)
  obtain ⟨size, refApart, entryApart⟩ := facts
  rintro (written | written)
  · exact InRange.offset_disjoint a cell.1 cell.2 1056 4
      (by omega) (by decide) refApart _ ⟨i, hi, rfl⟩ written
  · exact InRange.offset_disjoint a cell.1 cell.2 224 8
      (by omega) (by decide) entryApart _ ⟨i, hi, rfl⟩ written

theorem PeerStableFields.mutable_frame {before after : Mem 64}
    {a : BitVec 64} {p : Leanux.WG.Peer}
    (same : EqualOutside (fun address =>
      InRange (a + .ofNat 64 Layouts.peer_refcount) 4 address ∨
      InRange (a + .ofNat 64 peerHandshakePeerOffset) 8 address) before after)
    (represented : PeerStableFields before a p) : PeerStableFields after a p :=
  represented.frame same (peerStable_mutable_disjoint a)

#print axioms peerStable_mutable_disjoint
#print axioms PeerStableFields.mutable_frame
end Binary
