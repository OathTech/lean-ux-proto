#!/bin/sh
# Run the executed test of the cut's pivot against the mirror (C2CutTest.lean), against
# a built binary package. In no lake target. usage (from the worktree root):
#   binary/packets/c2/proof/check
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../../../.." && pwd)
cap() { if command -v capped >/dev/null 2>&1; then capped "$@"; else "$@"; fi; }
LP=$(cd "$root/binary" && ../scripts/in-bundle lake env printenv LEAN_PATH)
cd "$here"
cap "$root/scripts/in-bundle" env LEAN_PATH="$LP" lean C2CutTest.lean
