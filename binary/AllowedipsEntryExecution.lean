import AllowedipsEntryPost

namespace Binary.AllowedipsEntry
open TrustBase CommonBitsCoverage CommonBits Instrumentation
local instance : Labels := Image.linkedLabels

/-- Final PC callback before BH-disable preserves the exact converted query. -/
theorem converted_callback (fetch : Int64 → Option Decoded) (agree : AllowedipsDecoderAgreement fetch)
    (contract : AllowedipsTracePcContract fetch)
    {c coverage old ra initial world v}
    (pre : AllowedipsEntry c coverage old ra initial world v)
    (s : MachineData) (state : At initial coverage old ra s)
    (query : AllowedipsChild.QueryWords s.dmem (slot initial 8) c.bits c.key) (rxSection : Nat) :
    Eventually (historyStep fetch) (fun t =>
      QueryAtPC c initial coverage old ra (AllowedipsImage.Lookup.entry+0x66) t.machine ∧
      Local (TotalWrites initial coverage old) ⟨s,AllowedipsImage.Lookup.entry+0x61⟩ rxSection [] t)
      ⟨⟨s,AllowedipsImage.Lookup.entry+0x61⟩,[⟨s,AllowedipsImage.Lookup.entry+0x61⟩]⟩ := by
  have here := agree _ _ (show AllowedipsImage.fetch (AllowedipsImage.Lookup.entry+0x61)=
    some ⟨callInstruction "L_ffffffff810f3100",5⟩ from rfl)
  have run := callback fetch _ "L_ffffffff810f3100" here .pc contract pre s state rxSection
    (by intro after; rfl) (by decide)
  apply eventually_weaken (historyStep fetch) _ _ _ _ run
  rintro t ⟨⟨pc,next,frame⟩,trace⟩
  obtain ⟨_,_,physical⟩ := pre.related.2.1
  have family := physical.1.1
  refine ⟨⟨pc,next,?_⟩,trace.mono (fun _ h => writes_total h)⟩
  apply AllowedipsLoop.query_frame family query frame
  intro a read written
  rcases written with stack | buffer
  · exact query_call_apart initial c.bits family a read stack
  · exact pre.bufferStack a ⟨.inl buffer.1,buffer.2⟩ (query_live initial c.bits family a read)

theorem disable (fetch : Int64 → Option Decoded) (agree : AllowedipsDecoderAgreement fetch)
    {c coverage old ra initial world v}
    (pre : AllowedipsEntry c coverage old ra initial world v)
    (s : MachineData) (state : At initial coverage old ra s)
    (query : AllowedipsChild.QueryWords s.dmem (slot initial 8) c.bits c.key) (rxSection : Nat) :
    Eventually (historyStep fetch) (fun t =>
      Post c initial coverage old ra t.machine ∧
      Local (TotalWrites initial coverage old) ⟨s,AllowedipsImage.Lookup.entry+0x66⟩ rxSection [] t)
      ⟨⟨s,AllowedipsImage.Lookup.entry+0x66⟩,[⟨s,AllowedipsImage.Lookup.entry+0x66⟩]⟩ := by
  have run := disable_trace fetch agree s old (load32_raw _ _ _ state.memory.preempt) rxSection
  apply eventually_weaken (historyStep fetch) _ _ _ _ run
  rintro t ⟨⟨regs,memory,pc⟩,trace⟩
  exact ⟨after_disable pre state query regs memory pc,trace.mono (fun _ h => .inr (.inr h))⟩

theorem after_query (fetch : Int64 → Option Decoded) (agree : AllowedipsDecoderAgreement fetch)
    (contract : AllowedipsTracePcContract fetch)
    {c coverage old ra initial world v}
    (pre : AllowedipsEntry c coverage old ra initial world v)
    (s : MachineData) (state : At initial coverage old ra s)
    (query : AllowedipsChild.QueryWords s.dmem (slot initial 8) c.bits c.key) (rxSection : Nat) :
    Eventually (historyStep fetch) (fun t =>
      Post c initial coverage old ra t.machine ∧
      Local (TotalWrites initial coverage old) ⟨s,AllowedipsImage.Lookup.entry+0x61⟩ rxSection [] t)
      ⟨⟨s,AllowedipsImage.Lookup.entry+0x61⟩,[⟨s,AllowedipsImage.Lookup.entry+0x61⟩]⟩ := by
  have first := converted_callback fetch agree contract pre s state query rxSection
  apply chain fetch _ _ rxSection [] []
    (QueryAtPC c initial coverage old ra (AllowedipsImage.Lookup.entry+0x66))
    (Post c initial coverage old ra) first
  rintro ⟨d,pc⟩ ⟨equal,state,query⟩
  dsimp only at equal
  subst pc
  exact disable fetch agree pre d state query rxSection

/-- Complete executed outer entry, through both endian branches and the
actual BH-disable store. The post is physical and exports the next call's
readiness; its history is generated by Kraken from the supplied entry state. -/
theorem execution (fetch : Int64 → Option Decoded) (agree : AllowedipsDecoderAgreement fetch)
    (pcContract : AllowedipsTracePcContract fetch) (cmpContract : AllowedipsTraceConstCmp1Contract fetch)
    {c coverage old ra initial world v}
    (pre : AllowedipsEntry c coverage old ra initial world v) (rxSection : Nat) :
    Eventually (historyStep fetch) (fun t =>
      Post c initial coverage old ra t.machine ∧
      Local (TotalWrites initial coverage old) initial rxSection (signature c.bits rxSection) t)
      ⟨initial,[initial]⟩ := by
  have run := query_entry fetch agree pcContract cmpContract pre rxSection
  have first : Eventually (historyStep fetch) (fun t =>
      QueryAtPC c initial coverage old ra (AllowedipsImage.Lookup.entry+0x61) t.machine ∧
      Local (TotalWrites initial coverage old) initial rxSection (signature c.bits rxSection) t)
      ⟨initial,[initial]⟩ := by
    apply eventually_weaken (historyStep fetch) _ _ _ _ run
    intro t h
    exact ⟨h.1,h.2.mono (fun _ written => writes_total written)⟩
  have next : ∀ middle, QueryAtPC c initial coverage old ra (AllowedipsImage.Lookup.entry+0x61) middle →
      Eventually (historyStep fetch) (fun t => Post c initial coverage old ra t.machine ∧
        Local (TotalWrites initial coverage old) middle rxSection [] t) ⟨middle,[middle]⟩ := by
    rintro ⟨d,pc⟩ ⟨equal,state,query⟩
    dsimp only at equal
    subst pc
    exact after_query fetch agree pcContract pre d state query rxSection
  simpa only [List.append_nil] using chain fetch _ initial rxSection (signature c.bits rxSection) []
    (QueryAtPC c initial coverage old ra (AllowedipsImage.Lookup.entry+0x61))
    (Post c initial coverage old ra) first next

#print axioms execution
end Binary.AllowedipsEntry
