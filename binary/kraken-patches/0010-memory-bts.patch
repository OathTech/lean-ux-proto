diff --git a/Kraken/X64/BtsTests.lean b/Kraken/X64/BtsTests.lean
new file mode 100644
index 0000000..525da0e
--- /dev/null
+++ b/Kraken/X64/BtsTests.lean
@@ -0,0 +1,148 @@
+module
+
+import Kraken.X64.OmniSemantics
+import Kraken.X64.Parser
+import Kraken.X64.PrintATT
+import Kraken.X64.PrintIntel
+meta import Kraken.X64.PrintATT
+meta import Kraken.X64.PrintIntel
+meta import Kraken.X64.Semantics
+meta import Kraken.Mem
+
+namespace Kraken.X64.BtsTests
+
+private instance : Labels := ⟨fun _ => 0⟩
+
+/-- `bts %r15,(%rax)`: the one encoding in the pinned image (4c 0f ab 38). -/
+private def instruction : Instr :=
+  .regular .W64 .W64 (.bts {base := some (.reg .rax), idx := none} (.low .r15 .W64))
+
+private def execute (i : Instr) (s : MachineData) : Effects :=
+  i.interp s ⟨0, 4⟩ (fun d => .done ⟨d, 4⟩) (fun pc d => .done ⟨d, pc⟩)
+
+/-- Three quadwords at 0x1000; the instruction addresses the middle one. -/
+private def initial (below word above offset : Nat) (flags : Bool := false) : MachineData := {
+  regs := {rax := 0x1008, r15 := .ofNat offset, rbx := 99, rcx := 7, rsp := 0x8000}
+  status := {cf := flags, pf := flags, af := flags, zf := flags, sf := flags, of := flags}
+  system := {bits := 512, cpl := 0}
+  dmem := (Int.toBytes 24 (below + word * 2^64 + above * 2^128)).At 0x1000 }
+
+/-- Walk the effect tree: exactly one 8-byte read and one 8-byte write at the
+addressed quadword, in that order, and `post` at the end. `all` selects whether
+`post` must hold for every value of the undefined flags or for some. -/
+private def walk (all : Bool) (reads writes : Nat) (post : MachineState → Bool) : Effects → Bool
+  | .done s => reads == 0 && writes == 0 && post s
+  | .require_exec_access _ next => walk all reads writes post (next ())
+  | .require_read_access a w next =>
+    a == 0x1008 && w == .W64 && reads == 1 && writes == 1 && walk all 0 writes post (next ())
+  | .require_write_access a w next =>
+    a == 0x1008 && w == .W64 && reads == 0 && writes == 1 && walk all reads 0 post (next ())
+  | @Effects.undefined _ .bool next =>
+    if all then walk all reads writes post (next false) && walk all reads writes post (next true)
+    else walk all reads writes post (next false) || walk all reads writes post (next true)
+  | _ => false
+
+private def always := walk true 1 1
+private def sometimes := walk false 1 1
+
+/-- The step is declined with an explicit `unimplemented`, after at most the
+given number of read-access requests, without any write and without an MMIO
+(`nonmem_load`/`nonmem_store`) effect. -/
+private def declined (reads : Nat) : Effects → Bool
+  | .unimplemented _ => true
+  | .require_exec_access _ next => declined reads (next ())
+  | .require_read_access _ _ next => reads > 0 && declined (reads - 1) (next ())
+  | _ => false
+
+/-- CF is the old bit, the quadword comes back with the bit set, the neighbours,
+every register and the system flags are unchanged, and the PC advances; for
+every value of the undefined flags. -/
+private def check (word offset : Nat) (flags : Bool := false) : Bool :=
+  let s := initial 0x1111111111111111 word 0x2222222222222222 offset flags
+  always (fun t => t.pc == 4 && t.data.regs == s.regs && t.data.system == s.system &&
+    t.data.status.cf == word.testBit offset &&
+    t.data.dmem.loadInt 0x1008 8 == some ((word ||| 2^offset : Nat) : Int) &&
+    t.data.dmem.loadInt 0x1000 8 == some 0x1111111111111111 &&
+    t.data.dmem.loadInt 0x1010 8 == some 0x2222222222222222) (execute instruction s)
+
+-- Bit clear: CF = 0 and the bit is set. Offsets 0, 1, 63 and all between.
+#guard (List.range 64).all fun offset => check 0 offset
+#guard (List.range 64).all fun offset => check 0x5555555555555555 offset
+#guard (List.range 64).all fun offset => check 0xdeadbeef01234567 offset true
+-- Bit set: CF = 1 and the quadword is written back unchanged.
+#guard (List.range 64).all fun offset => check 0xffffffffffffffff offset
+#guard check 0x8000000000000000 63 && check 1 0 && check 2 1
+-- The write happens even when the bit was already set (one write access).
+#guard always (fun t => t.data.status.cf && t.data.dmem.loadInt 0x1008 8 == some 1)
+  (execute instruction (initial 0 1 0 0))
+#guard !walk true 1 0 (fun _ => true) (execute instruction (initial 0 1 0 0))
+-- CF does not depend on the incoming flags.
+#guard always (fun t => !t.data.status.cf) (execute instruction (initial 0 0 0 5 true))
+#guard always (fun t => t.data.status.cf) (execute instruction (initial 0 32 0 5 false))
+
+-- Each of OF, SF, ZF, AF and PF can come out either way from either incoming value.
+#guard [false, true].all fun incoming => [false, true].all fun outcome =>
+  let effect := execute instruction (initial 0 0 0 3 incoming)
+  sometimes (fun t => t.data.status.pf == outcome) effect &&
+  sometimes (fun t => t.data.status.af == outcome) effect &&
+  sometimes (fun t => t.data.status.zf == outcome) effect &&
+  sometimes (fun t => t.data.status.sf == outcome) effect &&
+  sometimes (fun t => t.data.status.of == outcome) effect
+-- ... and jointly: all five set, all five clear.
+#guard sometimes (fun t => t.data.status.pf && t.data.status.af && t.data.status.zf && t.data.status.sf && t.data.status.of)
+  (execute instruction (initial 0 0 0 3))
+#guard sometimes (fun t => !t.data.status.pf && !t.data.status.af && !t.data.status.zf && !t.data.status.sf && !t.data.status.of)
+  (execute instruction (initial 0 0 0 3 true))
+
+-- Offsets outside the addressed quadword are declined before any access.
+#guard [64, 65, 127, 128, 2^32, 2^63, 2^64 - 64, 2^64 - 1].all fun offset =>
+  declined 0 (execute instruction (initial 0 0 0 offset))
+#guard !declined 0 (execute instruction (initial 0 0 0 63))
+-- An unmapped or partly mapped quadword is declined, not treated as MMIO.
+#guard declined 1 (execute instruction {initial 0 0 0 3 with dmem := {}})
+#guard declined 1 (execute instruction {initial 0 0 0 3 with regs := {rax := 0x1011, r15 := 3}})
+#guard declined 1 (execute instruction {initial 0 0 0 3 with regs := {rax := 0xff9, r15 := 3}})
+#guard !declined 1 (execute instruction (initial 0 0 0 3))
+-- The effective address uses the full address expression; the register is the offset.
+#guard walk true 1 1 (fun t => t.data.status.cf == false && t.data.dmem.loadInt 0x1008 8 == some 0x200 &&
+    t.data.regs.rcx == 9)
+  (execute (.regular .W64 .W64 (.bts {base := some (.reg .rbx), idx := some ⟨.rdx, .W64⟩, disp := .int64 8}
+    (.low .rcx .W64))) {initial 0 0 0 0 with regs := {rbx := 0xff0, rdx := 2, rcx := 9}})
+-- Narrower operand sizes are not modeled even if constructed directly.
+#guard [Width.W8, .W16, .W32].all fun w =>
+  declined 0 (execute (.regular .W64 w (.bts {base := some (.reg .rax), idx := none} (.low .r15 w)))
+    (initial 0 0 0 3))
+
+-- Parser: the one accepted form, with and without the suffix.
+#guard match Parser.parse "bts %r15,(%rax)" with
+  | .ok p => p == [.instr instruction]
+  | .error _ => false
+#guard match Parser.parse "btsq %r15,(%rax)" with
+  | .ok p => p == [.instr instruction]
+  | .error _ => false
+-- Everything else fails closed: register destination, immediate offset,
+-- narrower widths, the LOCK prefix, and the sibling instructions.
+#guard !(Parser.parse "bts %r15,%rax").isOk
+#guard !(Parser.parse "btsq %r15,%rax").isOk
+#guard !(Parser.parse "bts $3,(%rax)").isOk
+#guard !(Parser.parse "btsq $3,(%rax)").isOk
+#guard !(Parser.parse "bts $3,%rax").isOk
+#guard !(Parser.parse "bts %r15d,(%rax)").isOk
+#guard !(Parser.parse "btsl %r15d,(%rax)").isOk
+#guard !(Parser.parse "bts %r15w,(%rax)").isOk
+#guard !(Parser.parse "btsw %r15w,(%rax)").isOk
+#guard !(Parser.parse "btsb %r15b,(%rax)").isOk
+#guard !(Parser.parse "btsq %r15d,(%rax)").isOk
+#guard !(Parser.parse "lock bts %r15,(%rax)").isOk
+#guard !(Parser.parse "lock btsq %r15,(%rax)").isOk
+#guard !(Parser.parse "btr %r15,(%rax)").isOk
+#guard !(Parser.parse "btc %r15,(%rax)").isOk
+
+-- Printers, and the AT&T round trip.
+#guard toString instruction == "bts QWORD PTR [rax+0], r15"
+#guard toATT [.instr instruction] == "btsq %r15, (%rax)"
+#guard match Parser.parse (toATT [.instr instruction]) with
+  | .ok p => p == [.instr instruction]
+  | .error _ => false
+
+end Kraken.X64.BtsTests
diff --git a/Kraken/X64/Parser/Basic.lean b/Kraken/X64/Parser/Basic.lean
index 6e8dfd8..f216d8a 100644
--- a/Kraken/X64/Parser/Basic.lean
+++ b/Kraken/X64/Parser/Basic.lean
@@ -1067,6 +1067,18 @@ def parseInstr : Parser Instr := do
     | .regular _ .W8 _ => fail "BT has no 8-bit form"
     | _ => pure instruction
 
+  -- BTS: only `bts r64, m64` (REX.W 0F AB /r), the one form in the pinned
+  -- WireGuard text. Register destinations, immediate offsets and the 16- and
+  -- 32-bit forms are rejected here; a LOCK prefix is not a mnemonic this
+  -- parser knows, so `lock bts` is rejected as well.
+  | "bts" | "btsq" => do
+    let (_, index) ← parseAO parseRegA .W64
+    parseComma
+    let (addr_w, dst) ← parseAO parseRegOrMem .W64
+    match dst with
+    | .mem a => pure (toInstr addr_w (.bts a index))
+    | .reg _ => fail "BTS: register destination is not modeled"
+
   -- Byte swap
   | "bsr" | "bsrw" | "bsrl" | "bsrq" => do
     let width ← if mn == "bsr" then pure none else some <$> instrWidth mn
