diff --git a/Kraken/X64/Test/asm/test_bts.S b/Kraken/X64/Test/asm/test_bts.S
new file mode 100644
index 0000000..a62013b
--- /dev/null
+++ b/Kraken/X64/Test/asm/test_bts.S
@@ -0,0 +1,33 @@
+# BTS r64, m64 (unlocked) against the host: CF and the written quadword.
+# The quadword lives on Kraken's stack mapping; popping it reads it back.
+# Bit clear at offset 5: CF = 0, the bit is set.
+movq $0x0123456789abcd00, %rbx
+pushq %rbx
+movq %rsp, %rax
+movq $5, %r15
+bts %r15, (%rax)
+setc %r8b
+popq %r9
+# Bit already set at offset 63: CF = 1, the quadword is unchanged.
+movq $0x8000000000000001, %rbx
+pushq %rbx
+movq %rsp, %rax
+movq $63, %r15
+btsq %r15, (%rax)
+setc %r10b
+popq %r11
+# Offset 0 on a clear bit, with CF set on entry (by the borrow) and a neighbour above.
+movq $0x7777777777777777, %rbx
+pushq %rbx
+movq $0xfffffffffffffffe, %rbx
+pushq %rbx
+movq %rsp, %rax
+movq $0, %r15
+movq $0, %rcx
+subq $1, %rcx
+bts %r15, (%rax)
+setc %r12b
+popq %r13
+popq %r14
+# OF, SF, ZF, AF and PF are undefined after BTS: define every flag again.
+addq $0, %rbx
