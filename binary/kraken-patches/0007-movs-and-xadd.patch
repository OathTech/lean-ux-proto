+/-- Sequential string move in 64-bit address mode. Source is read before
+destination is written, including overlaps. DF selects both index updates. -/
+def MachineData.movsOne (w : Width) (s : MachineData) (next : MachineData → Effects) : Effects :=
+  s.load s.regs.rsi.toBitVec w (fun value t =>
+    t.store s.regs.rdi.toBitVec value (fun u =>
+      next {u with regs := {u.regs with
+        rsi := if s.system.bits[10] then s.regs.rsi-UInt64.ofNat w.bytes else s.regs.rsi+UInt64.ofNat w.bytes
+        rdi := if s.system.bits[10] then s.regs.rdi-UInt64.ofNat w.bytes else s.regs.rdi+UInt64.ofNat w.bytes}}))
+
+def MachineData.movsRepeat (w : Width) : Nat → MachineData → (MachineData → Effects) → Effects
+  | 0,s,next => next s
+  | count+1,s,next => s.movsOne w (fun t =>
+      movsRepeat w count {t with regs := {t.regs with rcx := t.regs.rcx-1}} next)
+
 def MachineData.storeAvx (s : MachineData) (addr : BitVec 64) {w : AvxWidth} (v : w.type) (ret: MachineData → Effects) (checkAlign : Bool := false) : Effects :=
   if checkAlign && !(isAligned w.bytes addr) then
     .gp_unaligned addr w.bytes
@@ -531,6 +545,10 @@ set_option maxHeartbeats 1000000
