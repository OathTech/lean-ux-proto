     pure (toInstr .none (w := w) (.stos repeated))
   else fail "REP currently supports only STOS"
 
+def parseMovs (mn : String) (repeated : Bool) : Parser Instr := do
+  unless mn == "movsb" || mn == "movsw" || mn == "movsl" || mn == "movsq" do
+    fail "REP currently supports STOS and MOVS only"
+  let w ← instrWidth mn
+  skipHWs
+  let _ ← attempt (do
+    let _ ← (attempt (pstring "%ds:")) <|> pure ""
+    let _ ← pchar '('
+    let ⟨aw,source⟩ ← parseRegW
+    unless aw == .W64 && source == .low .rsi aw do fail "MOVS source must be RSI"
+    let _ ← pchar ')'
+    parseComma
+    let _ ← (attempt (pstring "%es:")) <|> pure ""
+    let _ ← pchar '('
+    let ⟨aw,destination⟩ ← parseRegW
+    unless aw == .W64 && destination == .low .rdi aw do fail "MOVS destination must be RDI"
+    let _ ← pchar ')'
+    pure ()) <|> pure ()
+  pure (toInstr .none (w := w) (.movs repeated))
+
 def parseInstr : Parser Instr := do
   skipHWs
   let mnemonic ← parseName
@@ -635,8 +655,10 @@ def parseInstr : Parser Instr := do
   | "rep" =>
     skipHWs
     let operation ← parseName
-    parseStos operation.toLower true
+    if operation.toLower.startsWith "stos" then parseStos operation.toLower true
+    else parseMovs operation.toLower true
   | "stos" | "stosb" | "stosw" | "stosl" | "stosq" => parseStos mn false
+  | "movsb" | "movsw" | "movsl" | "movsq" => parseMovs mn false
   -- Arithmetic (two-operand: src, dst) - 64-bit
   | "add" =>
     commaSeparated .none parseOperand parseRegOrMem .add
@@ -916,6 +938,11 @@ def parseInstr : Parser Instr := do
   | "cmpxchgq" | "cmpxchgl" | "cmpxchgw" | "cmpxchgb" => do
     let w ← instrWidth mn
     commaSeparated w parseRegA parseRegOrMem .cmpxchg
+  | "xadd" =>
+    commaSeparated .none parseRegA parseRegOrMem .xadd
+  | "xaddq" | "xaddl" | "xaddw" | "xaddb" => do
+    let w ← instrWidth mn
+    commaSeparated w parseRegA parseRegOrMem .xadd
 
   -- Test (sets flags based on AND without storing result)
   | "test" =>
