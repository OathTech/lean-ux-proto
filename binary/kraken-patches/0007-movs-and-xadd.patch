diff --git a/Kraken/X64/XaddTests.lean b/Kraken/X64/XaddTests.lean
new file mode 100644
index 0000000..1f2a660
--- /dev/null
+++ b/Kraken/X64/XaddTests.lean
@@ -0,0 +1,66 @@
+module
+import Kraken.X64.OmniSemantics
+import Kraken.X64.Parser
+import Kraken.X64.PrintATT
+meta import Kraken.X64.Semantics
+meta import Kraken.Mem
+meta import Kraken.X64.PrintATT
+
+namespace Kraken.X64.XaddTests
+private instance : Labels := ⟨fun _ => 0⟩
+private def instruction (w : Width) : Instr := .regular .W64 w
+  (.xadd (.mem {base := some (.reg .rbx),idx := none}) (.low .rcx w))
+private def execute (i : Instr) (s : MachineData) : Effects :=
+  i.interp s ⟨0,4⟩ (fun d => .done ⟨d,4⟩) (fun pc d => .done ⟨d,pc⟩)
+private def initial (w : Width) (src old : Nat) : MachineData := {
+  regs := {rbx := 0x1000,rcx := .ofNat src,rax := 73}
+  system := {bits := 512,cpl := 0}
+  dmem := (Int.toBytes w.bytes old).At 0x1000 }
+private def check (reads writes : Nat) (post : MachineState → Bool) : Effects → Bool
+  | .done s => reads==0 && writes==0 && post s
+  | .require_exec_access _ next => check reads writes post (next ())
+  | .require_read_access _ _ next => reads>0 && check (reads-1) writes post (next ())
+  | .require_write_access _ _ next => writes>0 && check reads (writes-1) post (next ())
+  | _ => false
+
+#guard [Width.W8,.W16,.W32,.W64].all fun w =>
+  check 1 1 (fun t => t.pc==4 && t.data.regs.rcx==5 && t.data.regs.rax==73 &&
+    t.data.dmem.loadInt 0x1000 w.bytes==some 14 && !t.data.status.cf &&
+    !t.data.status.af && !t.data.status.of && !t.data.status.zf &&
+    !t.data.status.sf && !t.data.status.pf && t.data.system==(initial w 9 5).system)
+    (execute (instruction w) (initial w 9 5))
+-- Carry, auxiliary carry, zero and even parity on wraparound, at each width.
+#guard [Width.W8,.W16,.W32,.W64].all fun w =>
+  check 1 1 (fun t => t.data.regs.rcx.toNat==2^w.bits-1 &&
+    t.data.dmem.loadInt 0x1000 w.bytes==some 0 && t.data.status.cf &&
+    t.data.status.af && !t.data.status.of && t.data.status.zf &&
+    !t.data.status.sf && t.data.status.pf)
+    (execute (instruction w) (initial w 1 (2^w.bits-1)))
+-- Signed overflow without unsigned carry.
+#guard [Width.W8,.W16,.W32,.W64].all fun w =>
+  check 1 1 (fun t => t.data.dmem.loadInt 0x1000 w.bytes==some (2^(w.bits-1) : Nat) &&
+    t.data.status.of && t.data.status.sf && !t.data.status.cf && !t.data.status.zf)
+    (execute (instruction w) (initial w 1 (2^(w.bits-1)-1)))
+-- Source writes obey partial-register preservation / 32-bit zero extension.
+#guard check 1 1 (fun t => t.data.regs.rcx==0x123400000005)
+  (execute (instruction .W8) (initial .W8 0x123400000009 5))
+#guard check 1 1 (fun t => t.data.regs.rcx==0x123400000005)
+  (execute (instruction .W16) (initial .W16 0x123400000009 5))
+#guard check 1 1 (fun t => t.data.regs.rcx==5)
+  (execute (instruction .W32) (initial .W32 0x123400000009 5))
+-- Effective address must be frozen before the source register is overwritten.
+#guard check 1 1 (fun t => t.data.regs.rcx==5 && t.data.dmem.loadInt 0x1000 8==some 0x1005)
+  (execute (.regular .W64 .W64
+    (.xadd (.mem {base := some (.reg .rcx),idx := none}) (.low .rcx .W64)))
+    (initial .W64 0x1000 5))
+#guard !check 1 1 (fun _ => true)
+  (execute (instruction .W64) {initial .W64 9 5 with dmem := {}})
+#guard !check 0 0 (fun _ => true)
+  (execute (.regular .W64 .W64 (.xadd (.reg (.low .rbx .W64)) (.low .rcx .W64)))
+    (initial .W64 9 5))
+#guard (Parser.parse "xadd %rcx,0x123(%rip)").isOk
+#guard (Parser.parse "xaddl %ecx,(%rbx)\nxaddb %cl,(%rbx)").isOk
+#guard !(Parser.parse "lock xadd %rcx,(%rbx)").isOk
+#guard !(Parser.parse "xadd $1,(%rbx)").isOk
+
+end Kraken.X64.XaddTests
diff --git a/notes/x64-movs-xadd.md b/notes/x64-movs-xadd.md
new file mode 100644
index 0000000..eb47d81
--- /dev/null
+++ b/notes/x64-movs-xadd.md
@@ -0,0 +1,29 @@
+# Recording-hook instructions
+
+The pinned single-CPU Linux image's random recording hook reaches REP MOVSB
+while copying a steered value and unlocked memory XADD while allocating a
+record sequence number. This private extension implements those operations.
+
+MOVS supports all operand widths with 64-bit addressing and both DF directions.
+Each element loads and stores before advancing the pointers, so overlap follows
+instruction order. REP uses the entry RCX count and decrements it per element;
+zero count issues no data-access requests. Unsupported address sizes fail.
+The parser accepts only the modeled default source/destination segments and
+RSI/RDI forms. XADD freezes the effective address, requests read and write
+access, stores the sum, returns the old destination in the source register,
+and sets the six arithmetic flags. Register destinations and LOCK remain
+unsupported. This adds no concurrent atomicity claim.
+
+References: Intel SDM volume 2B, MOVS and REP entries, and volume 2C, XADD entry:
+
+- https://www.intel.com/content/dam/www/public/us/en/documents/manuals/64-ia-32-architectures-software-developer-vol-2b-manual.pdf
+- https://www.intel.com/content/dam/www/public/us/en/documents/manuals/64-ia-32-architectures-software-developer-vol-2c-manual.pdf
+
+`Kraken.X64.MovsTests` checks both directions, all widths, overlap, zero count,
+missing memory, access counts and parser exclusions; its zero-count theorem
+uses only standard axioms. `Kraken.X64.XaddTests` checks arithmetic flags,
+partial-register writes, address/source aliasing, access counts, missing
+memory and unsupported forms. Both build and pass fresh `leanchecker` replay
+with Lean 4.35.0. Consumer memory and system-state preservation proofs also
+build and replay. Recording-enabled provider executions reach return with
+direct and remote steering, including exhaustion of the steering entries.
-- 
2.43.0

