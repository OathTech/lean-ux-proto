diff --git a/Kraken/X64/MovsTests.lean b/Kraken/X64/MovsTests.lean
new file mode 100644
index 0000000..2774f75
--- /dev/null
+++ b/Kraken/X64/MovsTests.lean
@@ -0,0 +1,69 @@
+module
+import Kraken.X64.OmniSemantics
+import Kraken.X64.Parser
+import Kraken.X64.PrintATT
+meta import Kraken.X64.Semantics
+meta import Kraken.Mem
+meta import Kraken.X64.PrintATT
+
+namespace Kraken.X64.MovsTests
+private instance : Labels := ⟨fun _ => 0⟩
+private def execute (aw w : Width) (repeated : Bool) (s : MachineData) : Effects :=
+  (Instr.regular aw w (.movs repeated)).interp s ⟨0,1⟩
+    (fun d => .done ⟨d,1⟩) (fun pc d => .done ⟨d,pc⟩)
+private def check (reads writes : Nat) (post : MachineState → Bool) : Effects → Bool
+  | .done s => reads==0 && writes==0 && post s
+  | .require_exec_access _ next => check reads writes post (next ())
+  | .require_read_access _ _ next => reads>0 && check (reads-1) writes post (next ())
+  | .require_write_access _ _ next => writes>0 && check reads (writes-1) post (next ())
+  | _ => false
+private def initial (backward : Bool) : MachineData := {
+  regs := {rsi := 0x1018,rdi := 0x2018,rcx := 3,rax := 37}
+  status := ⟨true,false,true,false,true,false⟩
+  system := {bits := if backward then 0x600 else 0x200,cpl := 0}
+  dmem := ((List.range 64).map (fun i => UInt8.ofNat (i+1))).At 0x1000 ∪
+    (List.replicate 64 (0 : UInt8)).At 0x2000 }
+
+#guard [false,true].all fun backward => [Width.W8,.W16,.W32,.W64].all fun w =>
+  let s := initial backward
+  let address (base i : Nat) := if backward then base-i*w.bytes else base+i*w.bytes
+  check 3 3 (fun t => t.pc==1 && t.data.regs.rcx==0 && t.data.regs.rax==37 &&
+    t.data.regs.rsi.toNat==address 0x1018 3 && t.data.regs.rdi.toNat==address 0x2018 3 &&
+    t.data.status==s.status && t.data.system==s.system &&
+    [0,1,2].all (fun i => t.data.dmem.loadInt (.ofNat 64 (address 0x2018 i)) w.bytes ==
+      s.dmem.loadInt (.ofNat 64 (address 0x1018 i)) w.bytes)) (execute .W64 w true s)
+
+#guard check 1 1 (fun t => t.data.regs.rcx==3 && t.data.regs.rsi==0x1019 && t.data.regs.rdi==0x2019)
+  (execute .W64 .W8 false (initial false))
+#guard check 0 0 (fun t => t.data.dmem=={} && t.data.regs.rsi==0 && t.data.regs.rdi==0)
+  (execute .W64 .W8 true {regs := {rcx := 0}})
+#guard !check 3 3 (fun _ => true) (execute .W64 .W8 true {initial false with dmem := {}})
+#guard !check 3 3 (fun _ => true) (execute .W32 .W8 true (initial false))
+-- Forward overlap reads the preceding write, rather than taking a bulk snapshot.
+#guard check 3 3 (fun t => t.data.dmem.loadBytes 0x1000 4==some [1,1,1,1])
+  (execute .W64 .W8 true {
+    regs := {rsi := 0x1000,rdi := 0x1001,rcx := 3}
+    dmem := ([1,2,3,4] : List UInt8).At 0x1000})
+-- The source exists but the destination does not: the attempted write fails.
+#guard !check 1 1 (fun _ => true)
+  (execute .W64 .W8 false {
+    regs := {rsi := 0x1000,rdi := 0x2000}
+    dmem := ([1] : List UInt8).At 0x1000})
+
+#guard match Parser.parse "rep movsb %ds:(%rsi),%es:(%rdi)\nmovsq\nrep movsl" with
+  | .ok p => p==[.instr (.regular .W64 .W8 (.movs true)),
+      .instr (.regular .W64 .W64 (.movs false)),.instr (.regular .W64 .W32 (.movs true))]
+  | .error _ => false
+#guard !(Parser.parse "rep movsb %fs:(%rsi),%es:(%rdi)").isOk
+#guard !(Parser.parse "rep movsb %ds:(%esi),%es:(%rdi)").isOk
+#guard !(Parser.parse "rep movsb %ds:(%rdi),%es:(%rsi)").isOk
+#guard !(Parser.parse "repne movsb").isOk
+#guard ATT.operation (w := .W8) .W64 (.movs true)=="rep movsb"
+
+theorem zero_count (s : MachineData) (zero : s.regs.rcx=0) :
+    (execute .W64 .W8 true s).All (fun t => t.pc=1 ∧ t.data=s) := by
+  simp [execute,Instr.interp,Operation.interp,MachineData.movsRepeat,zero,Effects.All,
+    show (Width.W64 != .W64)=false from rfl]
+
+#print axioms zero_count
+end Kraken.X64.MovsTests
