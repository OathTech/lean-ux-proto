From 4651c92fa728734240de7ff4d5bdff3f05875806 Mon Sep 17 00:00:00 2001
From: Mike Dodds <mike@oath.tech>
Date: Sun, 18 Oct 2026 19:06:01 +0000
Subject: [PATCH] Model sequential PUSHF and privileged interrupt-flag effects

[AGENT 2026-10-18] Keep non-arithmetic flags separate from arithmetic status. Model the 64-bit-mode flag and stack effects of PUSHF, CLI and STI with explicit unsupported privilege faults. Interrupt delivery and STI shadow remain outside the sequential model. RF, VM and reserved bits are excluded from the pushed image.

Validation: parser and concrete effect tests, symbolic CLI/STI effects with only standard axioms, and fresh leanchecker replay passed under Lean 4.35.0. The 729-job consumer regression passed after adding system state; a narrower rebuild passed after excluding persistent RF from the comparison projection.
---
 Kraken/X64/Parser/Basic.lean     |  4 ++
 Kraken/X64/PrintATT.lean         |  3 ++
 Kraken/X64/PrintIntel.lean       |  3 ++
 Kraken/X64/Semantics.lean        | 38 +++++++++++++
 Kraken/X64/Syntax.lean           |  3 ++
 Kraken/X64/SystemFlagsTests.lean | 92 ++++++++++++++++++++++++++++++++
 notes/x64-system-flags.md        | 24 +++++++++
 7 files changed, 167 insertions(+)
 create mode 100644 Kraken/X64/SystemFlagsTests.lean
 create mode 100644 notes/x64-system-flags.md

diff --git a/Kraken/X64/Parser/Basic.lean b/Kraken/X64/Parser/Basic.lean
index 38793e9..9e9874b 100644
--- a/Kraken/X64/Parser/Basic.lean
+++ b/Kraken/X64/Parser/Basic.lean
@@ -1029,6 +1029,10 @@ def parseInstr : Parser Instr := do
       pure (toInstr .none (.bswap dst))
 
   -- Stack operations
+  | "pushf" | "pushfq" => pure (toInstr .none (w := .W64) .pushf)
+  | "pushfw" => pure (toInstr .none (w := .W16) .pushf)
+  | "cli" => pure (toInstr .none (w := .W64) .cli)
+  | "sti" => pure (toInstr .none (w := .W64) .sti)
   | "push" =>
     let ( addr_w, src ) ← parseOperand
     -- Without a register to give the width (`push $1`, `push (%rax)`), push is 64-bit.
diff --git a/Kraken/X64/PrintATT.lean b/Kraken/X64/PrintATT.lean
index 7622c7e..2183b98 100644
--- a/Kraken/X64/PrintATT.lean
+++ b/Kraken/X64/PrintATT.lean
@@ -78,6 +78,9 @@ def operation {w} (aw : Width) (op : Operation w) : String :=
   | .movsx d x => s!"movsx {rm aw x}, {rm aw d}"
   | .movzx d x => s!"movzx {rm aw x}, {rm aw d}"
   | .push x => one "push" (operand aw x)
+  | .pushf => s!"pushf{s}"
+  | .cli => "cli"
