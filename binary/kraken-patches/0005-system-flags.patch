   | .pop d => one "pop" (rm aw d)
   | .setcc cc d => s!"set{cc} {rm aw d}"
   | .cmovcc cc d x => s!"cmov{cc} {rm aw x}, {reg d}"
diff --git a/Kraken/X64/PrintIntel.lean b/Kraken/X64/PrintIntel.lean
index c22571e..2ef8613 100644
--- a/Kraken/X64/PrintIntel.lean
+++ b/Kraken/X64/PrintIntel.lean
@@ -131,6 +131,9 @@ def Operation.toStr {w} (op : Operation w) (addr_w : Width := .W64) : String :=
     s!"{m} {dst.toStr addr_w}, {src.toStr addr_w}"
   | .movzx dst src => s!"movzx {dst.toStr addr_w}, {src.toStr addr_w}"
   | .push src => s!"push {src.toStr addr_w}"
+  | .pushf => if w == .W64 then "pushfq" else if w == .W16 then "pushf" else "invalid-pushf-width"
+  | .cli => "cli"
+  | .sti => "sti"
   | .pop dst => s!"pop {dst.toStr addr_w}"
   | .setcc cc dst => s!"set{cc} {dst.toStr addr_w}"
