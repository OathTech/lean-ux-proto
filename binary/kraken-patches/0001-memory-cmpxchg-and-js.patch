From eed58b7eda5d1873919616e996bcac205a724dc8 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Wed, 14 Oct 2026 18:17:53 +0000
Subject: [PATCH] Add memory cmpxchg and sign-condition semantics for WireGuard
 lookup

[AGENT 2026-10-14] Implement only the forms reached by peer-get: memory cmpxchg and the sign condition. Register destinations remain explicit unsupported effects. Freeze the destination address before accumulator writeback; request memory write permission on both comparison outcomes. Intel SDM vol. 2 CMPXCHG and Jcc define flags and effects. Tested success, failure, zero extension, borrow, signed overflow, accumulator addressing, parser rejection, and failed-compare write permission with capped lake build Kraken.X64.LookupTests Kraken.X64.PrintATT (Lean v4.35.0). No proof axiom introduced.
---
 Kraken/X64/LookupTests.lean  | 68 ++++++++++++++++++++++++++++++++++++
 Kraken/X64/Parser/Basic.lean |  7 ++++
 Kraken/X64/PrintATT.lean     |  1 +
 Kraken/X64/PrintIntel.lean   |  2 ++
 Kraken/X64/Semantics.lean    | 18 ++++++++++
 Kraken/X64/Syntax.lean       |  3 +-
 6 files changed, 98 insertions(+), 1 deletion(-)
 create mode 100644 Kraken/X64/LookupTests.lean

diff --git a/Kraken/X64/LookupTests.lean b/Kraken/X64/LookupTests.lean
new file mode 100644
index 0000000..fd9e6da
--- /dev/null
+++ b/Kraken/X64/LookupTests.lean
@@ -0,0 +1,68 @@
+module
+
+import Kraken.X64.OmniSemantics
+import Kraken.X64.Parser
+meta import Kraken.X64.Semantics
+meta import Kraken.Mem
+
+open Kraken.X64
+
+private instance : Labels := ⟨fun _ => 100⟩
+
+private def cx : Instr := .regular .W64 .W32
+  (.cmpxchg (.mem { base := some (.reg .rbx), idx := none }) (.low .rcx .W32))
+
+private def initial (acc value : UInt64) : MachineData := {
+  regs := { rax := acc, rbx := 0x1000, rcx := 9 }
+  dmem := (Int.toBytes 4 value.toNat).At 0x1000 }
+
+private def execute (i : Instr) (s : MachineData) : Effects :=
+  i.interp s ⟨0, 5⟩ (fun d => .done ⟨d, 5⟩) (fun p d => .done ⟨d, p⟩)
+
+-- Executable tests, not proof certificates. Errors and unmapped accesses fail.
+private def check (post : MachineState → Bool) : Effects → Bool
+  | .done s => post s
+  | .require_exec_access _ k => check post (k ())
+  | .require_read_access _ _ k => check post (k ())
+  | .require_write_access _ _ k => check post (k ())
+  | _ => false
+
+-- Success leaves the accumulator's upper half untouched.
+#guard check (fun t => t.pc == 5 && t.data.regs.rax == 0x123400000005 &&
+    t.data.status.zf && t.data.dmem.loadInt 0x1000 4 == some 9)
+  (execute cx (initial 0x123400000005 5))
+
+-- Failure writes back memory and zero-extends EAX.
+#guard check (fun t => t.data.regs.rax == 5 && !t.data.status.zf &&
+    t.data.dmem.loadInt 0x1000 4 == some 5 && !t.data.status.cf)
+  (execute cx (initial 0x123400000006 5))
+
+#guard check (fun t => t.data.status.cf && t.data.status.sf && !t.data.status.of)
+  (execute cx (initial 0 1))
+#guard check (fun t => !t.data.status.cf && !t.data.status.sf && t.data.status.of)
+  (execute cx (initial 0x80000000 1))
+
+-- Address uses the original RAX, before failure overwrites the accumulator.
+#guard check (fun t => t.data.regs.rax == 5 && t.data.dmem.loadInt 0x1000 4 == some 5)
+  (execute (.regular .W64 .W32
+    (.cmpxchg (.mem { base := some (.reg .rax), idx := none }) (.low .rcx .W32)))
+    { (initial 0x1000 5) with regs := { rax := 0x1000, rcx := 9 } })
+
+example (s : MachineData) :
+    (execute (.regular .W64 .W64 (.jcc .s "negative")) s).All
+      (fun t => t.pc = if s.status.sf then 100 else 5) := by
+  simp [execute, Instr.interp, Operation.interp, CondCode.interp, Effects.All]
+  split <;> simp_all [Effects.All, label]
+
+#guard (Parser.parse "cmpxchg %r12d,0x0(%r13)").isOk
+#guard (Parser.parse "js negative").isOk
+#guard !(Parser.parse "cmpxchg $1,0x0(%r13)").isOk
+
+-- Failure still requests write permission.
+#guard match execute cx (initial 6 5) with
+    | .require_exec_access _ k => match k () with
+      | .require_read_access _ _ k => match k () with
+        | .require_write_access a w _ => a == 0x1000 && w == .W32
+        | _ => false
+      | _ => false
+    | _ => false
