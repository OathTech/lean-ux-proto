diff --git a/Kraken/X64/Semantics.lean b/Kraken/X64/Semantics.lean
index 8a850cd..8bb2855 100644
--- a/Kraken/X64/Semantics.lean
+++ b/Kraken/X64/Semantics.lean
@@ -422,6 +422,7 @@ def CondCode.interp (cc : CondCode) (s : StatusFlags) : Bool := match cc with
   | .z  => s.zf | .nz => !s.zf | .c  => s.cf | .nc => !s.cf
   | .a  => !s.cf && !s.zf | .be => s.cf || s.zf
   | .l => s.sf != s.of | .le => (s.sf != s.of) || s.zf
+  | .s => s.sf
 
 @[kstep] def ShiftCountExpr.interp [Labels] (c : ShiftCountExpr) (s : MachineData) (p : Std.Rco Int64) := match c with
   | .cl => s.regs.rcx.toBitVec.take 8
@@ -569,6 +570,23 @@ set_option maxHeartbeats 1000000
       af := (v.take 4).unsigned != (a.take 4).unsigned - (b.take 4).unsigned,
       of := v.signed != a.signed - b.signed }
     next { s with status }))
+  -- Intel SDM vol. 2, CMPXCHG: compare accumulator - destination;
+  -- the memory destination receives a write even when comparison fails.
+  -- Only the memory form encountered in the pinned UP kernel is supported.
+  -- Freeze its address before a failed comparison overwrites the accumulator.
+  | .cmpxchg (.reg _) _ => unimplemented "CMPXCHG register destination"
+  | .cmpxchg (.mem dst) src =>
+    let addr := (dst.interp s.regs p).zeroExtend 64
+    let a := s.regs.get (.low .rax w)
+    let replacement := s.regs.get src
+    s.load addr w (fun b s =>
+    let v := a - b
+    let status := .from_result v {
+      cf := v.unsigned != a.unsigned - b.unsigned
+      af := (v.take 4).unsigned != (a.take 4).unsigned - (b.take 4).unsigned
+      of := v.signed != a.signed - b.signed }
+    { s with status }.store addr (if a == b then replacement else b) (fun s =>
+      next (if a == b then s else s.setReg (.low .rax w) b)))
   | .mul src =>
     let a := s.regs.get (Reg.low .rax w)
     src.interp s p (fun b s =>
