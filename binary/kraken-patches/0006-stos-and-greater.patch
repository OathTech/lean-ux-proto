+/-- One STOS element in 64-bit address mode. Flags are unchanged; the DF
+bit selects the post-store direction. Access checks use the ordinary store. -/
+def MachineData.stosOne (w : Width) (s : MachineData) (next : MachineData → Effects) : Effects :=
+  s.store s.regs.rdi.toBitVec (s.regs.get (.low .rax w)) (fun t =>
+    next {t with regs := {t.regs with rdi :=
+      if s.system.bits[10] then s.regs.rdi-UInt64.ofNat w.bytes else s.regs.rdi+UInt64.ofNat w.bytes}})
+
+/-- Sequential REP STOS. Each element retains its write-access effect;
+the structural counter is the entry RCX value, not a test execution bound. -/
+def MachineData.stosRepeat (w : Width) : Nat → MachineData → (MachineData → Effects) → Effects
+  | 0,s,next => next s
+  | count+1,s,next => s.stosOne w (fun t =>
+      stosRepeat w count {t with regs := {t.regs with rcx := t.regs.rcx-1}} next)
+
 def MachineData.storeAvx (s : MachineData) (addr : BitVec 64) {w : AvxWidth} (v : w.type) (ret: MachineData → Effects) (checkAlign : Bool := false) : Effects :=
   if checkAlign && !(isAligned w.bytes addr) then
     .gp_unaligned addr w.bytes
@@ -447,6 +461,7 @@ def CondCode.interp (cc : CondCode) (s : StatusFlags) : Bool := match cc with
   | .a  => !s.cf && !s.zf | .be => s.cf || s.zf
   | .l => s.sf != s.of | .le => (s.sf != s.of) || s.zf
   | .s => s.sf
+  | .g => !s.zf && (s.sf == s.of)
 
 @[kstep] def ShiftCountExpr.interp [Labels] (c : ShiftCountExpr) (s : MachineData) (p : Std.Rco Int64) := match c with
   | .cl => s.regs.rcx.toBitVec.take 8
@@ -512,6 +527,10 @@ set_option maxHeartbeats 1000000
     if s.system.cpl ≤ s.system.iopl then
       next { s with system := s.system.setIF true }
     else unimplemented "STI: #GP(0), CPL exceeds IOPL in 64-bit mode"
