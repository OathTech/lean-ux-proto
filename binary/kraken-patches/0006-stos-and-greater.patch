 -- ============================================================================
@@ -608,12 +609,34 @@ instance {T} : Coe (Option T) (Parser T) where coe := Option.toParser
 
 /-- Parse an instruction mnemonic and its operands.
     AT&T syntax: src, dst (reversed from Intel). -/
+def parseStos (mn : String) (repeated : Bool) : Parser Instr := do
+  if mn == "stos" then
+    let ⟨w,source⟩ ← parseRegW
+    unless source == .low .rax w do fail "STOS source must be the accumulator"
+    parseComma
+    let _ ← (attempt (pstring "%es:")) <|> pure ""
+    let _ ← pchar '('
+    let ⟨aw,destination⟩ ← parseRegW
+    unless aw == .W64 && destination == .low .rdi aw do
+      fail "STOS currently requires the 64-bit RDI destination"
+    let _ ← pchar ')'
+    pure (toInstr .none (w := w) (.stos repeated))
+  else if mn == "stosb" || mn == "stosw" || mn == "stosl" || mn == "stosq" then
+    let w ← instrWidth mn
+    pure (toInstr .none (w := w) (.stos repeated))
+  else fail "REP currently supports only STOS"
+
 def parseInstr : Parser Instr := do
   skipHWs
   let mnemonic ← parseName
   let mn := mnemonic.toLower
   -- Match on full mnemonic name (no suffix stripping)
   match mn with
+  | "rep" =>
+    skipHWs
+    let operation ← parseName
+    parseStos operation.toLower true
+  | "stos" | "stosb" | "stosw" | "stosl" | "stosq" => parseStos mn false
   -- Arithmetic (two-operand: src, dst) - 64-bit
   | "add" =>
     commaSeparated .none parseOperand parseRegOrMem .add
