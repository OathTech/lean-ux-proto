diff --git a/Kraken/X64/GreaterTests.lean b/Kraken/X64/GreaterTests.lean
new file mode 100644
index 0000000..892ed7c
--- /dev/null
+++ b/Kraken/X64/GreaterTests.lean
@@ -0,0 +1,32 @@
+module
+import Kraken.X64.OmniSemantics
+import Kraken.X64.Parser
+import Kraken.X64.PrintATT
+meta import Kraken.X64.Semantics
+
+namespace Kraken.X64.GreaterTests
+private instance : Labels := ⟨fun _ => 64⟩
+
+-- Exhaust all relevant flags, including equal and overflow cases. The
+-- expected condition is the complement of signed less-or-equal.
+#guard [false,true].all fun z => [false,true].all fun s => [false,true].all fun o =>
+  let flags : StatusFlags := {cf := false,pf := false,af := false,zf := z,sf := s,of := o}
+  CondCode.g.interp flags == !(CondCode.le.interp flags)
+
+#guard match Parser.parse "jg target", Parser.parse "jnle target" with
+  | .ok left,.ok right => left==right
+  | _,_ => false
+#guard (Parser.parse "jg target").isOk
+#guard (Parser.parse "setg %al").isOk
+#guard (Parser.parse "cmovg %eax,%ebx").isOk
+
+theorem greater_branch (s : MachineData) (p : Std.Rco Int64) (target : Label) :
+    (Instr.regular .W64 .W64 (.jcc .g target)).interp s p
+      (fun t => .done ⟨t,p.upper⟩) (fun pc t => .done ⟨t,pc⟩) |>.All
+      (fun t => t.data=s ∧ t.pc=if !s.status.zf && (s.status.sf==s.status.of)
+        then Labels.label target else p.upper) := by
+  simp [Instr.interp,Operation.interp,CondCode.interp,Effects.All]
+  split <;> simp_all [Effects.All]
+
+#print axioms greater_branch
+end Kraken.X64.GreaterTests
