diff --git a/Kraken/X64/StosTests.lean b/Kraken/X64/StosTests.lean
new file mode 100644
index 0000000..0f5cbb2
--- /dev/null
+++ b/Kraken/X64/StosTests.lean
@@ -0,0 +1,90 @@
+module
+
+import Kraken.X64.OmniSemantics
+import Kraken.X64.Parser
+import Kraken.X64.PrintATT
+meta import Kraken.X64.Semantics
+meta import Kraken.Mem
+meta import Kraken.X64.PrintATT
+
+namespace Kraken.X64.StosTests
+private instance : Labels := ⟨fun _ => 0⟩
+
+private def execute (aw w : Width) (repeated : Bool) (s : MachineData) : Effects :=
+  (Instr.regular aw w (.stos repeated)).interp s ⟨0,1⟩
+    (fun d => .done ⟨d,1⟩) (fun pc d => .done ⟨d,pc⟩)
+
+private def check (expectedWrites : Nat) (post : MachineState → Bool) : Effects → Bool
+  | .done s => expectedWrites==0 && post s
+  | .require_exec_access _ next => check expectedWrites post (next ())
+  | .require_write_access _ _ next => expectedWrites>0 && check (expectedWrites-1) post (next ())
+  | _ => false
+
+private def initial (backward : Bool) : MachineData :=
+  { regs := {rax := 0x1122334455667788,rdi := 0x1018,rcx := 3,rbx := 37}
+    status := ⟨true,false,true,false,true,false⟩
+    system := {bits := (if backward then 0x600 else 0x200),cpl := 0}
+    dmem := (List.replicate 64 (0 : UInt8)).At 0x1000 }
+
+-- Expected bytes/register motion are computed from the architectural width,
+-- independently of the execution helper. Check both DF directions and all sizes.
+#guard [false,true].all fun backward => [Width.W8,.W16,.W32,.W64].all fun w =>
+  let s := initial backward
+  let step := w.bytes
+  let address (i : Nat) := if backward then 0x1018-i*step else 0x1018+i*step
+  check 3 (fun t => t.pc==1 && t.data.regs.rcx==0 &&
+    t.data.regs.rdi.toNat==address 3 && t.data.regs.rax==s.regs.rax &&
+    t.data.regs.rbx==37 && t.data.status==s.status && t.data.system==s.system &&
+    [0,1,2].all (fun i => t.data.dmem.loadInt (.ofNat 64 (address i)) step ==
+      some (s.regs.rax.toNat%2^w.bits : Int))) (execute .W64 w true s)
+
+#guard check 1 (fun t => t.data.regs.rcx==3 && t.data.regs.rdi==0x1020 &&
+    t.data.dmem.loadInt 0x1018 8==some 0x1122334455667788)
+  (execute .W64 .W64 false (initial false))
+#guard check 0 (fun t => t.data.regs.rdi==0xffffffffffffffff && t.data.regs.rcx==0 &&
+    t.data.dmem=={} && t.data.status==(initial true).status)
+  (execute .W64 .W64 true {initial true with
+    regs := {(initial true).regs with rcx := 0,rdi := 0xffffffffffffffff},dmem := {}})
+#guard !check 3 (fun _ => true) (execute .W64 .W64 true {initial false with dmem := {}})
+#guard !check 3 (fun _ => true) (execute .W32 .W64 true (initial false))
+
+-- Permission requests are emitted for every attempted element. The third
+-- write is unmapped here, after two successful stores; it cannot report return.
+private def missingThird (writes : Nat) : Effects → Bool
+  | .require_exec_access _ next => missingThird writes (next ())
+  | .require_write_access _ _ next => missingThird (writes+1) (next ())
+  | .nonmem_store _ address _ _ => writes==3 && address==0x1010
+  | _ => false
+#guard missingThird 0 (execute .W64 .W64 true {
+  regs := {rax := 7,rdi := 0x1000,rcx := 3}
+  dmem := (List.replicate 16 (0 : UInt8)).At 0x1000})
+
+#guard match Parser.parse "rep stos %rax,%es:(%rdi)\nstosb\nrep stosl" with
+  | .ok p => p==[.instr (.regular .W64 .W64 (.stos true)),
+      .instr (.regular .W64 .W8 (.stos false)),.instr (.regular .W64 .W32 (.stos true))]
+  | .error _ => false
+#guard (Parser.parse "rep stosq").isOk
+#guard (Parser.parse "stos %ax,(%rdi)").isOk
+#guard !(Parser.parse "rep movq").isOk
+#guard !(Parser.parse "repne stosq").isOk
+#guard !(Parser.parse "rep stos %rbx,%es:(%rdi)").isOk
+#guard !(Parser.parse "rep stos %rax,%es:(%edi)").isOk
+#guard !(Parser.parse "rep stos %rax,%fs:(%rdi)").isOk
+#guard !(Parser.parse "lock stosq").isOk
+#guard ATT.operation (w := .W64) .W64 (.stos true)=="rep stosq"
+
+theorem zero_count (s : MachineData) (zero : s.regs.rcx=0) :
+    (execute .W64 .W64 true s).All (fun t => t.pc=1 ∧ t.data=s) := by
+  simp [execute,Instr.interp,Operation.interp,MachineData.stosRepeat,zero,Effects.All,
+    show (Width.W64 != .W64)=false from rfl]
+
+theorem single_word_flags (s : MachineData) (old : Int)
+    (mapped : s.dmem.loadInt s.regs.rdi.toBitVec 8=some old) :
+    (execute .W64 .W64 false s).All (fun t =>
+      t.pc=1 ∧ t.data.status=s.status ∧ t.data.system=s.system ∧ t.data.regs.rcx=s.regs.rcx) := by
+  simp [execute,Instr.interp,Operation.interp,MachineData.stosOne,MachineData.store,mapped,
+    Effects.All,show (Width.W64 != .W64)=false from rfl]
+
+#print axioms zero_count
+#print axioms single_word_flags
+end Kraken.X64.StosTests
