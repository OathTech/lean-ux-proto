diff --git a/Kraken/X64/Semantics.lean b/Kraken/X64/Semantics.lean
index 8bb2855..e2565e8 100644
--- a/Kraken/X64/Semantics.lean
+++ b/Kraken/X64/Semantics.lean
@@ -736,6 +736,19 @@ set_option maxHeartbeats 1000000
     let (cf, v) := (t.msb, t.take w.bits)
     (λ setof => if count == 1 then setof (v.msb != a.msb) else undefined setof) (λ of =>
     { s with status := { s.status with cf, of } }.set dst v p next))
+  | .bsr dst src =>
+    if w == .W8 then unimplemented "BSR has no 8-bit form" else
+    src.interp s p (fun a s =>
+      let finish (s : MachineData) :=
+        undefined (fun cf => undefined (fun pf => undefined (fun af =>
