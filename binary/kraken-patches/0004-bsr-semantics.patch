@@ -1009,6 +1009,13 @@ def parseInstr : Parser Instr := do
     pure (toInstr addr_w (.rcr dst cnt))
 
   -- Byte swap
+  | "bsr" | "bsrw" | "bsrl" | "bsrq" => do
+    let width ← if mn == "bsr" then pure none else some <$> instrWidth mn
+    let instruction ← commaSeparated width parseRegOrMem parseRegA .bsr
+    match instruction with
+    | .regular _ .W8 _ => fail "BSR has no 8-bit form"
+    | _ => pure instruction
+
   | "bswap" =>
     let ⟨ _w, dst ⟩ ← parseRegW
     pure (toInstr .none (.bswap dst))
