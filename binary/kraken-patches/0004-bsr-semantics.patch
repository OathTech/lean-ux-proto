diff --git a/Kraken/X64/BsrTests.lean b/Kraken/X64/BsrTests.lean
new file mode 100644
index 0000000..7e92d91
--- /dev/null
+++ b/Kraken/X64/BsrTests.lean
@@ -0,0 +1,132 @@
+module
+
+import Kraken.X64.OmniSemantics
+import Kraken.X64.Parser
+import Kraken.X64.PrintIntel
+meta import Kraken.X64.Semantics
+meta import Kraken.Mem
+meta import Kraken.X64.PrintIntel
+
+namespace Kraken.X64.BsrTests
+
+private instance : Labels := ⟨fun _ => 0⟩
+
+private def execute (i : Instr) (s : MachineData) : Effects :=
+  i.interp s ⟨0, 4⟩ (fun d => .done ⟨d, 4⟩) (fun pc d => .done ⟨d, pc⟩)
+
+private def checkAllBools (post : MachineState → Bool) : Effects → Bool
+  | .done s => post s
+  | @Effects.undefined _ .bool next =>
+      checkAllBools post (next false) && checkAllBools post (next true)
+  | .require_exec_access _ next => checkAllBools post (next ())
+  | .require_read_access _ _ next => checkAllBools post (next ())
+  | _ => false
+
+private def regInstruction (w : Width) : Instr :=
+  .regular .W64 w (.bsr (.low .rbx w) (.reg (.low .rax w)))
+
+private def someBoolOutcome (post : MachineState → Bool) : Effects → Bool
+  | .done s => post s
+  | @Effects.undefined _ .bool next =>
+      someBoolOutcome post (next false) || someBoolOutcome post (next true)
+  | .require_exec_access _ next => someBoolOutcome post (next ())
+  | .require_read_access _ _ next => someBoolOutcome post (next ())
+  | _ => false
+
+#guard someBoolOutcome (fun t => t.data.regs.rbx == 0x123456789abcdef0)
+  (execute (regInstruction .W32) {regs := {rax := 0, rbx := 0x123456789abcdef0}})
+#guard someBoolOutcome (fun t => t.data.regs.rbx == 0x9abcdef0)
+  (execute (regInstruction .W32) {regs := {rax := 0, rbx := 0x123456789abcdef0}})
+#guard someBoolOutcome (fun t => t.data.status.cf && t.data.status.pf &&
+    t.data.status.af && t.data.status.sf && t.data.status.of)
+  (execute (regInstruction .W64) {regs := {rax := 1}})
+#guard someBoolOutcome (fun t => !t.data.status.cf && !t.data.status.pf &&
+    !t.data.status.af && !t.data.status.sf && !t.data.status.of)
+  (execute (regInstruction .W64) {regs := {rax := 1}})
+
+#guard checkAllBools (fun t => t.pc == 4 && t.data.regs.rbx == 63 &&
+    !t.data.status.zf && t.data.regs.rax == 0x8000000000000000)
+  (execute (regInstruction .W64) {regs := {rax := 0x8000000000000000, rbx := 99}})
+
+#guard checkAllBools (fun t => t.data.regs.rbx == 0 && !t.data.status.zf)
+  (execute (regInstruction .W64) {regs := {rax := 1, rbx := 99}})
+
+#guard checkAllBools (fun t => t.data.regs.rbx == 31 && !t.data.status.zf)
+  (execute (regInstruction .W32) {regs := {rax := 0x80000000, rbx := 0xffffffffffffffff}})
+
+#guard checkAllBools (fun t => t.data.regs.rbx == 0x123456789abc000f && !t.data.status.zf)
+  (execute (regInstruction .W16) {regs := {rax := 0x8000, rbx := 0x123456789abcdef0}})
+
+#guard checkAllBools (fun t => t.data.regs.rbx == 0x123456789abcdef0 && t.data.status.zf)
+  (execute (regInstruction .W64) {regs := {rax := 0, rbx := 0x123456789abcdef0}})
+
+#guard checkAllBools (fun t => t.data.regs.rbx == 0x123456789abcdef0 && t.data.status.zf)
+  (execute (regInstruction .W16) {regs := {rax := 0x10000, rbx := 0x123456789abcdef0}})
+
+#guard checkAllBools (fun t =>
+    (t.data.regs.rbx == 0x123456789abcdef0 || t.data.regs.rbx == 0x9abcdef0) && t.data.status.zf)
+  (execute (regInstruction .W32) {regs := {rax := 0x100000000, rbx := 0x123456789abcdef0}})
+
+#guard checkAllBools (fun t => t.data.regs.rax == 8 && !t.data.status.zf)
+  (execute (.regular .W64 .W64 (.bsr (.low .rax .W64) (.reg (.low .rax .W64))))
+    {regs := {rax := 0x101}})
+
+#guard checkAllBools (fun t => t.data.regs.rax == 7 && !t.data.status.zf &&
+    t.data.dmem.loadInt 0x1000 8 == some 128)
+  (execute (.regular .W64 .W64 (.bsr (.low .rax .W64)
+    (.mem {base := some (.reg .rax), idx := none})))
+    {regs := {rax := 0x1000}, dmem := (Int.toBytes 8 128).At 0x1000})
+
+#guard !checkAllBools (fun _ => true)
+  (execute (.regular .W64 .W64 (.bsr (.low .rax .W64)
+    (.mem {base := some (.reg .rax), idx := none}))) {regs := {rax := 0x1000}})
+
+#guard !checkAllBools (fun _ => true) (execute (regInstruction .W8) {})
+
+#guard match Parser.parse "bsr %edx,%eax" with
+  | .ok p => p == [.instr (.regular .W64 .W32
+      (.bsr (.low .rax .W32) (.reg (.low .rdx .W32))))]
+  | .error _ => false
+#guard match Parser.parse "bsrq 8(%r12),%rbx" with
+  | .ok p => p == [.instr (.regular .W64 .W64 (.bsr (.low .rbx .W64)
+      (.mem {base := some (.reg .r12), idx := none, disp := .int64 8})))]
+  | .error _ => false
+#guard !(Parser.parse "bsr %al,%bl").isOk
+#guard !(Parser.parse "bsrb %al,%bl").isOk
+#guard !(Parser.parse "bsr $1,%eax").isOk
+#guard !(Parser.parse "bsr %eax,(%rbx)").isOk
+#guard !(Parser.parse "bsr %eax,%rbx").isOk
+#guard !(Parser.parse "bsrq %eax,%ebx").isOk
+#guard !(Parser.parse "lock bsr %eax,%ebx").isOk
+
+#guard toString (regInstruction .W64) == "bsr rbx, rax"
+#guard toString (regInstruction .W32) == "bsr ebx, eax"
+
+theorem zero64_preserves (s : MachineData)
+    (zero : s.regs.get (.low .rax .W64) = 0) :
+    (execute (regInstruction .W64) s).All (fun t =>
+      t.pc = 4 ∧ t.data.regs = s.regs ∧ t.data.dmem = s.dmem ∧ t.data.status.zf = true) := by
+  have width8 : (Width.W64 == Width.W8) = false := rfl
+  have width32 : (Width.W64 == Width.W32) = false := rfl
+  simp [execute, regInstruction, Instr.interp, Operation.interp, RegOrMem.interp,
+    zero, Effects.All, width8, width32]
+
+#print axioms zero64_preserves
+
+theorem nonzero64_index (s : MachineData)
+    (nonzero : s.regs.get (.low .rax .W64) ≠ 0) :
+    (execute (regInstruction .W64) s).All (fun t =>
+      t.pc = 4 ∧ t.data.regs.get (.low .rbx .W64) =
+        BitVec.ofNat 64 (s.regs.get (.low .rax .W64)).toNat.log2 ∧
+      t.data.dmem = s.dmem ∧ t.data.status.zf = false) := by
+  have width8 : (Width.W64 == Width.W8) = false := rfl
+  simp [execute, regInstruction, Instr.interp, Operation.interp, RegOrMem.interp,
+    Effects.All, width8]
+  simp [MachineData.setReg, Reg64s.set, Reg64s.get,
+    Reg64s.set64, Reg64s.get64, Reg.base, Reg.offset, BitVec.take, BitVec.drop]
+  simp [Reg64s.get, Reg64s.get64, Reg.base, Reg.offset, BitVec.take, BitVec.drop] at nonzero
+  simp [nonzero, Effects.All]
+
+#print axioms nonzero64_index
+
+end Kraken.X64.BsrTests
