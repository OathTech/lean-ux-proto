+            finish (if clearUpper then s.setReg dst (s.regs.get dst) else s))
+        else finish s
+      else finish (s.setReg dst (.ofNat w.bits a.toNat.log2)))
   | .bswap dst =>
     let a := s.regs.get dst
     match (generalizing := false) (motive := Width → Effects) w with
