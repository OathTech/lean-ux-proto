diff --git a/Kraken/X64/BtTests.lean b/Kraken/X64/BtTests.lean
new file mode 100644
index 0000000..ae71909
--- /dev/null
+++ b/Kraken/X64/BtTests.lean
@@ -0,0 +1,82 @@
+module
+
+import Kraken.X64.OmniSemantics
+import Kraken.X64.Parser
+import Kraken.X64.PrintATT
+import Kraken.X64.PrintIntel
+meta import Kraken.X64.PrintIntel
+meta import Kraken.X64.Semantics
+
+namespace Kraken.X64.BtTests
+
+private instance : Labels := ⟨fun _ => 0⟩
+
+private def execute (i : Instr) (s : MachineData) : Effects :=
+  i.interp s ⟨0, 3⟩ (fun d => .done ⟨d, 3⟩) (fun pc d => .done ⟨d, pc⟩)
+
+private def allFlags (post : MachineState → Bool) : Effects → Bool
+  | .done s => post s
+  | @Effects.undefined _ .bool next => allFlags post (next false) && allFlags post (next true)
+  | .require_exec_access _ next => allFlags post (next ())
+  | _ => false
+
+private def someFlags (post : MachineState → Bool) : Effects → Bool
+  | .done s => post s
+  | @Effects.undefined _ .bool next => someFlags post (next false) || someFlags post (next true)
+  | .require_exec_access _ next => someFlags post (next ())
+  | _ => false
+
+private def instruction (w : Width) : Instr :=
+  .regular .W64 w (.bt (.low .rax w) (.low .rcx w))
+
+private def check (w : Width) (value index : UInt64) (bit : Bool) : Bool :=
+  let state : MachineData := {regs := {rax := value,rcx := index,rbx := 99},status := {cf := false,pf := false,af := false,zf := true,sf := false,of := false}}
+  allFlags (fun t => t.pc == 3 && t.data.regs == state.regs &&
+    t.data.status.cf == bit) (execute (instruction w) state)
+
+#guard check .W16 0x123456789abc8000 15 true
+#guard check .W16 0x123456789abc8000 31 true
+#guard check .W16 0xffff0000 16 false
+#guard check .W32 0xdeadbeef80000000 31 true
+#guard check .W32 0xdeadbeef80000000 63 true
+#guard check .W32 0xdeadbeef80000000 0xffffffffffffffff true
+#guard check .W32 0xffffffff00000000 32 false
+#guard check .W64 0x8000000000000000 63 true
+#guard check .W64 0x8000000000000000 127 true
+#guard check .W64 1 64 true
+#guard check .W64 1 65 false
+#guard allFlags (fun t => t.data.regs.rax == 0x100000001 && !t.data.status.cf)
+  (execute (.regular .W64 .W32 (.bt (.low .rax .W32) (.low .rax .W32)))
+    {regs := {rax := 0x100000001}})
+#guard someFlags (fun t => t.data.status.pf && t.data.status.af && t.data.status.zf && t.data.status.sf && t.data.status.of)
+  (execute (instruction .W32) {})
+#guard someFlags (fun t => !t.data.status.pf && !t.data.status.af && !t.data.status.zf && !t.data.status.sf && !t.data.status.of)
+  (execute (instruction .W32) {})
+-- Either ZF result must be permitted, independently of its incoming value.
+#guard [Width.W16, Width.W32, Width.W64].all fun w =>
+  [false, true].all fun initial =>
+    let effect := execute (instruction w) {status := {cf := false,pf := false,af := false,zf := initial,sf := false,of := false}}
+    someFlags (fun t => t.data.status.zf) effect &&
+      someFlags (fun t => !t.data.status.zf) effect
+#guard !allFlags (fun _ => true) (execute (instruction .W8) {})
+#guard match Parser.parse "bt %ecx,%eax" with
+  | .ok p => p == [.instr (instruction .W32)]
+  | .error _ => false
+#guard match Parser.parse "btq %rcx,%rax" with
+  | .ok p => p == [.instr (instruction .W64)]
+  | .error _ => false
+#guard match Parser.parse "btw %cx,%ax" with
+  | .ok p => p == [.instr (instruction .W16)]
+  | .error _ => false
+#guard !(Parser.parse "bt %cl,%al").isOk
+#guard !(Parser.parse "btb %cl,%al").isOk
+#guard !(Parser.parse "bt %ecx,%rax").isOk
+#guard !(Parser.parse "btq %ecx,%eax").isOk
+#guard !(Parser.parse "bt %ecx,(%rax)").isOk
+#guard !(Parser.parse "bt $1,%eax").isOk
+#guard !(Parser.parse "lock bt %ecx,%eax").isOk
+
+#guard toString (instruction .W64) == "bt rax, rcx"
+#guard toString (instruction .W16) == "bt ax, cx"
+
+end Kraken.X64.BtTests
diff --git a/Kraken/X64/Parser/Basic.lean b/Kraken/X64/Parser/Basic.lean
index e2c2998..6e8dfd8 100644
--- a/Kraken/X64/Parser/Basic.lean
+++ b/Kraken/X64/Parser/Basic.lean
@@ -1058,6 +1058,15 @@ def parseInstr : Parser Instr := do
     let ( addr_w, dst ) ← parseRegOrMemAO w
     pure (toInstr addr_w (.rcr dst cnt))
 
+  -- Register/register BT is the form used by the allowed-IPs insertion image.
+  -- Memory/immediate operands are deliberately rejected until modeled.
+  | "bt" | "btw" | "btl" | "btq" => do
+    let width ← if mn == "bt" then pure none else some <$> instrWidth mn
+    let instruction ← commaSeparated width parseRegA parseRegA .bt
+    match instruction with
+    | .regular _ .W8 _ => fail "BT has no 8-bit form"
+    | _ => pure instruction
+
   -- Byte swap
   | "bsr" | "bsrw" | "bsrl" | "bsrq" => do
     let width ← if mn == "bsr" then pure none else some <$> instrWidth mn
