import AllowedipsSourceEvents
import AllowedipsSourceSteps

namespace Binary.AllowedipsSource
open Leanux Leanux.WG MirrorHistory

def finishStep (bits key fuel : Nat) (step : ForInStep Acc) : Logged (Option NodeId) :=
  match step with
  | .done acc => finish acc
  | .yield acc => do let result ← loop bits key fuel acc; finish result

theorem afterGuard_body (bits key fuel id : Nat) (previous : Option NodeId) (node : AipNode)
    (w : World) (history : List Point) (step : ForInStep Acc)
    (present : nodeView w id = some node)
    (selected : selectStep (nodeView w) bits key (none,some id,previous) = some step) :
    ((afterGuard bits key fuel id previous).run history).run w =
      ((finishStep bits key fuel step).run (history ++ bodyPoints bits key node w)).run (bodyWorld bits key node w) := by
  have body := nodeBody_run bits key id previous node w history step present selected
  unfold afterGuard
  simp only [StateT.run_bind,body]
  rfl

theorem finishStep_done (bits key fuel : Nat) (acc : Acc)
    (done : acc.1 = some acc.2.2) : finishStep bits key fuel (.done acc) = pure acc.2.2 := by
  simp only [finishStep,finish,done]

theorem finishStep_zero (bits key : Nat) (acc : Acc) (pending : acc.1 = none)
    (history points : List Point) (w final : World) (answer : Option NodeId) :
    ((finishStep bits key 0 (.yield acc)).run history).run w ≠ .ok ((answer,points),final) := by
  simp only [finishStep,loop,pure_bind,finish,pending]
  intro impossible
  cases impossible

theorem loop_none_finish (bits key fuel : Nat) (answer : Option (Option NodeId)) (found : Option NodeId) :
    (do let result ← loop bits key (fuel+1) (answer,none,found); finish result) =
      (do _ ← branchLogged .findNodeNode false; pure found) := by
  simp only [loop,iteration,bind_assoc]
  congr 1

theorem finishStep_none (bits key fuel : Nat) (acc : Acc) (empty : acc.2.1 = none) :
    finishStep bits key (fuel+1) (.yield acc) =
      (do _ ← branchLogged .findNodeNode false; pure acc.2.2) := by
  rcases acc with ⟨answer,current,found⟩
  change current = none at empty
  subst current
  exact loop_none_finish bits key fuel answer found

theorem finishStep_some (bits key fuel next : Nat) (acc : Acc) (more : acc.2.1 = some next) :
    finishStep bits key (fuel+1) (.yield acc) =
      (do _ ← branchLogged .findNodeNode true; afterGuard bits key fuel next acc.2.2) := by
  rcases acc with ⟨answer,current,found⟩
  change current = some next at more
  subst current
  exact loop_some_finish bits key fuel next answer found

/-- The source guard advances only its cumulative decision log. -/
theorem nodeView_record (w : World) (d : Decision) (b : Bool) :
    nodeView (LookupMirror.record w d b) = nodeView w := rfl

theorem nodeView_bodyWorld (bits key : Nat) (node : AipNode) (w : World) :
    nodeView (bodyWorld bits key node w) = nodeView w := by
  funext id
  simp only [nodeView,bodyWorld_kernel]

#print axioms afterGuard_body
#print axioms finishStep_done
#print axioms finishStep_zero
#print axioms finishStep_none
#print axioms finishStep_some
end Binary.AllowedipsSource
