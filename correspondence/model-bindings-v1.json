  "state_fields": [
    {
      "linux": "files_struct.fdtable.fd[] and open_fds",
      "mirror": "Files.fdTable: Nat → Option FDEntry",
      "relation": "Trace slots8..31 retain membership and file identity.0..7 implicitly reserved; temporary reservation bitmap folded into installation."
    },
    {
      "linux": "fdtable.close_on_exec",
      "mirror": "FDEntry.cloexec",
      "relation": "One bit per descriptor, independent of aliases."
    },
    {
      "linux": "files_struct.next_fd",
      "mirror": "Files.nextFd",
      "relation": "Cursor preserved between operations; alloc advances and close lowers."
    },
    {
      "linux": "task rlimit(RLIMIT_NOFILE)",
      "mirror": "Files.limit",
      "relation": "Fixture/model bound32."
    },
    {
      "linux": "struct file * and file.private_data",
      "mirror": "FDEntry.objectId and Files.objects",
      "relation": "Distinct eventfd creations get fresh logical identities; aliases retain identical objectId."
    },
    {
      "linux": "file.f_flags",
      "mirror": "File.statusFlags",
      "relation": "O_RDWR|O_NONBLOCK=2050 for every supported file; creationCLOEXEC and SEMAPHORE do not remain here."
    },
    {
      "linux": "eventfd_ctx.count",
      "mirror": "Eventfd.Ctx.count: UInt64",
      "relation": "Exact unsigned64 bit pattern."
    },
    {
      "linux": "eventfd_ctx.flags & EFD_SEMAPHORE",
      "mirror": "Eventfd.Ctx.semaphore: Bool",
      "relation": "True iff bit0 nonzero; other context flag bits not read by chosen local computation."
    },
    {
      "linux": "allocation freshness and lifetime",
      "mirror": "Files.nextObject and unreachable historical objects",
      "relation": "Logical identity freshness; numeric addresses, allocator reuse and rawrefcounts abstracted."
    }
  ],
  "limitations": [
    "Bindings check declared helpers and labels exist. They do not prove that labels describe executed C branches.",
    "KCOV PCs require the matching vmlinux and source line maps; uninstrumented paths are not inferred covered.",
    "Source-to-reference formal semantics remains open; local reference and mirror are distinct encodings."
  ]
