  "classification_note": "Branches classify the configured source/domain. Represented mappings are review obligations until accepted implementation and comparison evidence are attached; they are not a C semantics proof.",
  "helper_records": [
    {
      "id": "syscall-abi",
      "source": {
        "file": "arch/x86/include/asm/syscall_wrapper.h",
        "anchor": "#define __X64_SYS_STUB"
      },
      "mirror": [
        "Leanux.Runner"
      ],
      "points": [
        "x86_64 register entry",
        "__se_sys argument casts",
        "__do_sys operation body"
      ],
      "state": [
        "six x86-64 argument registers",
        "unsigned32 descriptor/count/flag bit patterns"
      ],
      "effects": [
        "return signed long without retries"
      ],
      "branches": [
        {
          "id": "abi.native",
          "condition": "native x86-64 syscall entry",
          "classification": "represented",
          "reason": "Runner input rules retain low32 flags/init and signed32 descriptor literals; kernel casts descriptors to unsigned32."
        },
        {
          "id": "abi.compat",
          "condition": "compatibility or x32 entry",
          "classification": "excluded",
          "reason": "Only native x86-64 guest ABI is supported."
        }
      ],
      "external": [
        "abi"
      ]
    },
    {
      "id": "alloc-fd",
      "source": {
        "file": "fs/file.c",
        "anchor": "static int alloc_fd("
      },
      "mirror": [
        "Leanux.FS.allocFd"
      ],
      "points": [
        "start/max(next_fd)",
        "find next free slot",
        "limit check",
        "reserve slot/cursor/cloexec"
      ],
      "state": [
        "fdtable membership",
        "files.next_fd",
        "RLIMIT_NOFILE=32",
        "descriptor CLOEXEC"
      ],
      "effects": [
        "lowest available descriptor",
        "EMFILE when no slot8..31"
      ],
      "branches": [
        {
          "id": "alloc.limit",
          "condition": "fd >= end",
          "classification": "represented",
          "reason": "EMFILE and unchanged externally visible state."
        },
        {
          "id": "alloc.scan",
          "condition": "fd < max_fds; occupied/free slot",
          "classification": "represented",
          "reason": "Bounded ascending scan retains allocation order."
        },
        {
          "id": "alloc.expand",
          "condition": "expand_files returns positive or negative",
          "classification": "excluded",
          "reason": "Initial table capacity NR_OPEN_DEFAULT=64 covers all admissible descriptors below32; no resize."
        },
        {
          "id": "alloc.cursor",
          "condition": "start <= files->next_fd",
          "classification": "represented",
          "reason": "start0 with cursor>=8 always advances successful allocation."
        },
        {
          "id": "alloc.cloexec",
          "condition": "flags & O_CLOEXEC",
          "classification": "represented",
          "reason": "Descriptor-local bit."
        },
        {
          "id": "alloc.inconsistent",
          "condition": "reserved slot contains non-NULL file",
          "classification": "excluded",
          "reason": "Single-thread fixture and well-formed slots preclude inconsistent reservation."
        }
      ],
      "external": [
        "locks-rcu",
        "allocator"
      ]
    },
