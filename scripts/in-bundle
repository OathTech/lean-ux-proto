#!/usr/bin/python3
"""Select the local toolchain; confinement belongs to the calling nono session."""
import os
import json
from pathlib import Path
import subprocess
import sys

root = Path(__file__).resolve().parents[1]
workspace = root / '.leanux-workspace.json'
settings = json.loads(workspace.read_text()) if workspace.exists() else {}
if not settings and (root / '.git').is_file():
    # A plain `git worktree add .worktrees/<id>` checkout: shared tools and
    # dependencies live in the main checkout; caches and outputs stay private
    # to this worktree (both Git-ignored, removed with it).
    common = subprocess.run(['git', '-C', str(root), 'rev-parse', '--path-format=absolute', '--git-common-dir'],
                            capture_output=True, text=True, check=True).stdout.strip()
    settings = {'shared_root': str(Path(common).parent)}
# A nested invocation may switch worktrees. Do not carry the previous task's
# writable directories into the new one. Explicit callers can unset LEANUX_ROOT.
same_workspace = os.environ.get('LEANUX_ROOT') in (None, str(root))
def option(name, default):
    return os.environ.get(name, default) if same_workspace else default
shared = Path(option('LEANUX_SHARED_ROOT', settings.get('shared_root', root))).resolve()
scratch = Path(settings.get('scratch_root', root)).resolve()
cache = Path(option('LEANUX_CACHE_ROOT', settings.get('cache_root', scratch / '.cache'))).resolve()
artifacts = Path(option('LEANUX_ARTIFACTS', settings.get('artifacts_root', scratch / '.artifacts'))).resolve()
# These checks prevent accidental writes outside the project. OS confinement is
# independently applied by nono; configuration is not an authorization boundary.
for path in (root, cache, artifacts):
    if not path.is_relative_to(shared):
        raise SystemExit(f'Workspace path outside shared project: {path}')
sysroot = shared / '.tools/sysroot'
if not (sysroot / 'usr/bin/gcc-13').is_file():
    raise SystemExit('Missing staged sysroot. Run scripts/stage-resources.py packages first.')

for name in ('tmp', 'lake', 'elan', 'go-build', 'go', 'bundle-bin', 'bundle-libs'):
    (cache / name).mkdir(parents=True, exist_ok=True)
artifacts.mkdir(parents=True, exist_ok=True)
if not (shared / '.deps/go-mod').is_dir():
    raise SystemExit('Missing staged offline Go module store')
config = cache / 'lake-config.toml'
if not config.exists():
    config.write_text('')

def link(path, target):
    if path.is_symlink() and path.readlink() == target:
        return
    if path.exists() or path.is_symlink():
        raise SystemExit(f'Unexpected existing bundle link: {path}')
    try:
        path.symlink_to(target)
    except FileExistsError:
        # Independent commands may initialize the same local links concurrently.
        if not path.is_symlink() or path.readlink() != target:
            raise

# Keep the host loader and glibc together. Other shared libraries come from the
# staged packages. These are links only; .tools is never modified.
glibc = ('ld-linux', 'libc.so', 'libm.so', 'libmvec.', 'libpthread.', 'librt.',
         'libdl.', 'libresolv.', 'libnss_', 'libanl.', 'libBrokenLocale.',
         'libthread_db.', 'libutil.')
for lib in (sysroot / 'usr/lib/x86_64-linux-gnu').glob('*.so*'):
    if not lib.name.startswith(glibc):
        link(cache / 'bundle-libs' / lib.name, lib)

commands = ['gcc', 'cc', 'g++', 'c++', 'cpp', 'gcc-13', 'g++-13', 'cpp-13',
            'x86_64-linux-gnu-gcc', 'x86_64-linux-gnu-g++', 'x86_64-linux-gnu-cpp',
            'x86_64-linux-gnu-gcc-13', 'x86_64-linux-gnu-g++-13',
            'x86_64-linux-gnu-cpp-13', 'ld', 'x86_64-linux-gnu-ld',
            'clang', 'clang++', 'clang-19', 'clang++-19',
            'qemu-system-x86_64', 'qemu-system-aarch64']
for name in commands:
    link(cache / 'bundle-bin' / name, root / 'scripts/bundle-tool')

env = os.environ.copy()
for name in ('LD_PRELOAD', 'LD_AUDIT', 'CPATH', 'C_INCLUDE_PATH',
             'CPLUS_INCLUDE_PATH', 'LIBRARY_PATH', 'COMPILER_PATH', 'GCC_EXEC_PREFIX',
             'PYTHONHOME', 'PYTHONPATH', 'PERL5OPT', 'GOFLAGS',
             'CC', 'CXX', 'CPP', 'HOSTCC', 'HOSTCXX', 'LD', 'AS', 'AR', 'NM',
             'OBJCOPY', 'OBJDUMP', 'READELF', 'STRIP',
             'LEAN_PATH', 'LEAN_SRC_PATH', 'LEAN_SYSROOT', 'LEAN', 'LAKE',
             'LAKE_HOME', 'LAKE_OVERRIDE_LEAN', 'ELAN_TOOLCHAIN'):
    env.pop(name, None)
env.update({
    'LEANUX_ROOT': str(root), 'LEANUX_SHARED_ROOT': str(shared),
    'LEANUX_CACHE_ROOT': str(cache), 'LEANUX_ARTIFACTS': str(artifacts),
    'LEANUX_SYSROOT': str(sysroot),
    'PATH': ':'.join(str(p) for p in (cache / 'bundle-bin', shared / '.tools/lean/bin',
                                   shared / '.tools/go/bin', sysroot / 'usr/bin', sysroot / 'bin')),
    'LD_LIBRARY_PATH': str(cache / 'bundle-libs'),
    'LC_ALL': 'C', 'LANG': 'C', 'TERM': 'dumb',
    'TMPDIR': str(cache / 'tmp'), 'TMPPREFIX': str(cache / 'tmp/zsh'),
    'XDG_CACHE_HOME': str(cache), 'ELAN_HOME': str(cache / 'elan'),
    'LAKE_CACHE_DIR': str(cache / 'lake'), 'LAKE_CONFIG': str(config),
    'LAKE_NO_CACHE': 'true',
    'GOROOT': str(shared / '.tools/go'),
    'GOPATH': str(cache / 'go'), 'GOMODCACHE': str(shared / '.deps/go-mod'),
    'GOCACHE': str(cache / 'go-build'), 'GOENV': 'off',
    'GOTOOLCHAIN': 'local', 'GOPROXY': 'off', 'GOSUMDB': 'off', 'GOMAXPROCS': '4',
    'PKG_CONFIG_SYSROOT_DIR': str(sysroot), 'PKG_CONFIG_PATH': '',
    'PKG_CONFIG_LIBDIR': ':'.join(str(sysroot / p) for p in
        ('usr/lib/x86_64-linux-gnu/pkgconfig', 'usr/lib/pkgconfig', 'usr/share/pkgconfig')),
    'BISON_PKGDATADIR': str(sysroot / 'usr/share/bison'),
    'M4': str(sysroot / 'usr/bin/m4'),
    'PERL': str(sysroot / 'usr/bin/perl'),
    'PERL5LIB': ':'.join(str(sysroot / p) for p in
        ('usr/lib/x86_64-linux-gnu/perl-base', 'usr/lib/x86_64-linux-gnu/perl/5.38',
         'usr/share/perl/5.38', 'usr/share/perl5')),
    'PYTHONNOUSERSITE': '1', 'PYTHONDONTWRITEBYTECODE': '1',
    'PYTHONPATH': str(sysroot / 'etc/python3.12'),
    'QEMU_MODULE_DIR': str(sysroot / 'usr/lib/x86_64-linux-gnu/qemu'),
    'TZDIR': str(sysroot / 'usr/share/zoneinfo'),
    'TERMINFO_DIRS': str(sysroot / 'usr/share/terminfo') + ':' + str(sysroot / 'usr/lib/terminfo'),
})
argv = sys.argv[1:] or [str(sysroot / 'usr/bin/bash'), '--noprofile', '--norc']
os.execvpe(argv[0], argv, env)
