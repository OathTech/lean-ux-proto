#!/usr/bin/env python3
"""Standalone binary experiment gate: pinned semantics, build, axioms,
printed trust surface, and proof-source escapes. Run from the repository root
with `scripts/binary-proof-gate`; kernel replay is the separate external gate
specified in binary/README.md. This does not build the mirror proof campaign.
"""
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
PERMITTED = {'propext', 'Classical.choice', 'Quot.sound'}
FORBIDDEN = re.compile(r'\b(sorry|sorryAx|admit|axiom|native_decide|ofReduceBool|trustCompiler|skipKernelTC'
                       r'|unsafe|implemented_by|extern)\b|(\+\s*native)\b')
DEPENDS = re.compile(r"^'([^']+)' depends on axioms: \[([^\]]*)\]$")
NO_AXIOMS = re.compile(r"^'([^']+)' does not depend on any axioms$")
failures = []


def fail(message):
    failures.append(message)
    print(f'FAIL: {message}', file=sys.stderr, flush=True)


def capped(command):
    named = os.environ.get('LEANUX_CAPPED')
    if named:
        if not os.access(named, os.X_OK):
            raise SystemExit(f'LEANUX_CAPPED names no executable: {named}')
        return [named, '--'] + command
    available = shutil.which('capped')
    if available:
        return [available, '--'] + command
    print('note: capped is not installed; building uncapped', file=sys.stderr, flush=True)
    return command


def strip_comments(text):
    """Blank out `--` line comments and (nested) `/- ... -/` block comments,
    keeping line structure so hits report the right line. String literals are
    blanked too (their contents are not code, and a `--` inside one must not
    swallow the rest of the line); the quote character literal `'"'` is
    skipped so it does not open a string."""
    out = []
    i, depth, n = 0, 0, len(text)
    while i < n:
        two = text[i:i + 2]
        if depth == 0 and text[i:i + 3] == "'\"'":
            out.append("'  ")
            i += 3
            continue
        if depth == 0 and text[i] == '"':
            out.append(' ')
            i += 1
            while i < n and text[i] != '"':
                if text[i] == '\\' and i + 1 < n and text[i + 1] != '\n':
                    out.append(' ')
                    i += 1
                out.append(text[i] if text[i] == '\n' else ' ')
                i += 1
            if i >= n:
                raise SystemExit('unterminated string literal while scanning the proof tree')
            out.append(' ')
            i += 1
            continue
        if depth == 0 and two == '--':
            while i < n and text[i] != '\n':
                i += 1
            continue
        if two == '/-':
            depth += 1
            i += 2
            continue
        if depth > 0 and two == '-/':
            depth -= 1
            i += 2
            continue
        out.append(text[i] if depth == 0 or text[i] == '\n' else ' ')
        i += 1
    if depth != 0:
        raise SystemExit('unterminated block comment while scanning the proof tree')
    return ''.join(out)


def check_axioms(names, cwd, imports):
    print(f'[2/4] #print axioms for {len(names)} terminal statements', flush=True)
    artifacts = ROOT / '.tmp' / 'binary-proof-gate'
    artifacts.mkdir(parents=True, exist_ok=True)
    scratch = artifacts / 'axioms.lean'
    scratch.write_text(''.join(f'import {name}\n' for name in imports)
                       + ''.join(f'#print axioms {name}\n' for name in names))
    result = subprocess.run(capped(['lake', 'env', 'lean', str(scratch)]), cwd=cwd, capture_output=True, text=True)
    (artifacts / 'axioms.out').write_text(result.stdout + result.stderr)
    # Lean wraps a long axiom list over continuation lines that start with a
    # space; join them back before parsing.
    lines = []
    for raw in (result.stdout + result.stderr).splitlines():
        if raw[:1] == ' ' and lines:
            lines[-1] += ' ' + raw.strip()
        else:
            lines.append(raw)
    seen = {}
    for line in lines:
        if not line.strip():
            continue
        if (m := DEPENDS.match(line)):
            axioms = {a.strip() for a in m.group(2).split(',') if a.strip()}
        elif (m := NO_AXIOMS.match(line)):
            axioms = set()
        else:
            fail(f'unrecognised line from lean: {line}')
            continue
        name = m.group(1)
        if name in seen:
            fail(f'{name} printed twice')
        seen[name] = axioms
        extra = axioms - PERMITTED
        print(f'  {name}: {sorted(axioms) or "no axioms"}', flush=True)
        if extra:
            fail(f'{name} depends on {sorted(extra)}')
    for name in names:
        if name not in seen:
            fail(f'{name} did not print its axioms')
    for name in seen:
        if name not in names:
            fail(f'unexpected statement printed: {name}')
    if result.returncode != 0:
        fail(f'lean exited {result.returncode} on the axiom scratch file')


def main():
    if sys.argv[1:]:
        raise SystemExit("usage: binary-proof-gate")
    """Standalone charter surface; no dependency on lagging mirror proofs."""
    sys.path.insert(0, str(ROOT / 'binary'))
    from pin import verify_pin
    from surface import HEADLINES, IMPORTS, check_surface
    print('[binary] private Kraken pin/cleanliness, build, axioms, trust-surface diff, source escapes', flush=True)
    try:
        print(f'Kraken pin and clean tree: {verify_pin(ROOT)}', flush=True)
    except (ValueError, OSError, subprocess.CalledProcessError) as exc:
        fail(str(exc))
        return 1
    result = subprocess.run(capped(['lake', '-d', 'binary', 'build']), cwd=ROOT)
    if result.returncode:
        fail(f'binary build exited {result.returncode}')
    if not failures:
        check_axioms(HEADLINES, cwd=ROOT / 'binary', imports=IMPORTS)
        try:
            check_surface()
        except (ValueError, OSError, subprocess.CalledProcessError) as exc:
            fail(str(exc))
    # Attic definitions are deliberately outside the proof path. The default
    # BinaryProofs build and kernel replay check the actual import closure.
    files = sorted((ROOT / 'binary').glob('*.lean'))
    if not files:
        fail('binary has no Lean sources')
    for path in files:
        for number, line in enumerate(strip_comments(path.read_text()).splitlines(), 1):
            for match in FORBIDDEN.finditer(line):
                fail(f'{path.relative_to(ROOT)}:{number}: {match.group(0)}')
    print('binary proof gate: ' + ('FAILED' if failures else 'PASS'), flush=True)
    return 1 if failures else 0


if __name__ == '__main__':
    sys.exit(main())
