#!/usr/bin/env python3
"""The gate of the binary track's bridge library (AGENTS.md, "Gates and
speedbumps"). `binary/bridge/C2Bridge.lean` is the one file outside
`Leanux/Proofs/` that may import the proof tree, and of it only the four
`CounterWindow` modules below. Run from the repository root at the binary
track's claim points:

    capped -- scripts/in-bundle scripts/c2-bridge-gate

In order:
1. The Kraken pin and clean tree (`binary/pin.py`, as the binary gate does).
2. `lake -d binary build C2Bridge`.
3. `#print axioms` for every theorem of the bridge; any axiom beyond
   `propext`, `Classical.choice` and `Quot.sound` fails, and so does a
   theorem in the source that is not in THEOREMS. Then the statements: the
   type of every theorem as `#check` prints it, compared with
   `binary/bridge/C2Bridge.expected.txt`; any difference fails. That file is
   a specification: `--write-expected` replaces it, and its diff is reviewed.
4. The proof tree's forbidden-token scan over `binary/bridge/*.lean`,
   comments and strings stripped.
5. The bridge's imports. Asked of Lean, on the built module: the modules of
   the proof tree among everything the bridge imports, directly or through
   any other module, must be exactly the four. And read from the source: its
   own import lines name the four and otherwise only modules of the binary
   package; no other Lean file in `binary/bridge/`; `C2Bridge` not a default
   target.
6. The lag report: the last commit of the four modules and of the mirror,
   beside the mirror commit the register row (`docs/proofs.md`) names. The
   row may say "Current" only if no mirror file differs from that commit.
"""
import difflib
from importlib.machinery import SourceFileLoader
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
BRIDGE_DIR = ROOT / 'binary' / 'bridge'
BRIDGE = BRIDGE_DIR / 'C2Bridge.lean'
TARGET = 'C2Bridge'
BRIDGE_IMPORTS = {'Leanux.Proofs.WG.CounterWindow.' + name
                  for name in ('Model', 'Refinement', 'MirrorCalls', 'Bounds')}
THEOREMS = ['Binary.C2.Bridge.' + name for name in (
    'accepts_as_pure_window', 'no_counter_accepted_twice_of_parts',
    'no_counter_accepted_twice', 'headline', 'replay_refused')]
MIRROR = ['Leanux/FS', 'Leanux/WG', 'Leanux/Net', 'Leanux/Kernel', 'Leanux/Env.lean', 'Leanux/Runner.lean']
EXPECTED = BRIDGE_DIR / 'C2Bridge.expected.txt'
REGISTER = ROOT / 'docs' / 'proofs.md'
ROW = '| C2 bridge:'

# One scanner and one axiom grammar for both binary gates.
sys.dont_write_bytecode = True
binary_gate = SourceFileLoader('binary_proof_gate', str(ROOT / 'scripts' / 'binary-proof-gate')).load_module()
failures = []


def fail(message):
    failures.append(message)
    print(f'FAIL: {message}', file=sys.stderr, flush=True)


def git(*args):
    return subprocess.check_output(['git', '-C', str(ROOT), *args], text=True).strip()


def check_axioms():
    print(f'[3/6] #print axioms for {len(THEOREMS)} theorems of the bridge', flush=True)
    artifacts = ROOT / '.tmp' / 'c2-bridge-gate'
    artifacts.mkdir(parents=True, exist_ok=True)
    scratch = artifacts / 'axioms.lean'
    scratch.write_text(f'import {TARGET}\n' + ''.join(f'#print axioms {name}\n' for name in THEOREMS))
    result = subprocess.run(binary_gate.capped(['lake', 'env', 'lean', str(scratch)]), cwd=ROOT / 'binary',
                            capture_output=True, text=True)
    lines = []
    for raw in (result.stdout + result.stderr).splitlines():
        if raw[:1] == ' ' and lines:
            lines[-1] += ' ' + raw.strip()
        else:
            lines.append(raw)
    seen = {}
    for line in lines:
        if not line.strip():
            continue
        if (m := binary_gate.DEPENDS.match(line)):
            axioms = {a.strip() for a in m.group(2).split(',') if a.strip()}
        elif (m := binary_gate.NO_AXIOMS.match(line)):
            axioms = set()
        else:
            fail(f'unrecognised line from lean: {line}')
            continue
        if m.group(1) in seen:
            fail(f'{m.group(1)} printed twice')
        seen[m.group(1)] = axioms
        print(f'  {m.group(1)}: {sorted(axioms) or "no axioms"}', flush=True)
        if axioms - binary_gate.PERMITTED:
            fail(f'{m.group(1)} depends on {sorted(axioms - binary_gate.PERMITTED)}')
    for name in THEOREMS:
        if name not in seen:
            fail(f'{name} did not print its axioms')
    for name in seen:
        if name not in THEOREMS:
            fail(f'unexpected statement printed: {name}')
    if result.returncode != 0:
        fail(f'lean exited {result.returncode} on the axiom scratch file')


def render_statements():
    """The bridge's theorems with their types, printed as the binary gate prints its surface."""
    artifacts = ROOT / '.tmp' / 'c2-bridge-gate'
    artifacts.mkdir(parents=True, exist_ok=True)
    scratch = artifacts / 'statements.lean'
    scratch.write_text(f'import {TARGET}\nset_option format.width 110\nset_option pp.universes true\n'
                       + ''.join(f'#check @{name}\n' for name in THEOREMS))
    result = subprocess.run(binary_gate.capped(['lake', 'env', 'lean', str(scratch)]), cwd=ROOT / 'binary',
                            capture_output=True, text=True)
    if result.returncode or result.stderr:
        fail(f'printing the bridge\'s statements failed:\n{result.stdout}{result.stderr}')
        return None
    return result.stdout.rstrip() + '\n'


def check_statements():
    print(f'      the statements of the {len(THEOREMS)} theorems against {EXPECTED.relative_to(ROOT)}', flush=True)
    actual = render_statements()
    if actual is None:
        return
    for line in actual.splitlines():
        if not line.startswith(' '):
            print(f'  {line}'[:160], flush=True)
    if not EXPECTED.exists():
        fail(f'{EXPECTED.relative_to(ROOT)} is missing')
        return
    delta = ''.join(difflib.unified_diff(EXPECTED.read_text().splitlines(keepends=True),
                                         actual.splitlines(keepends=True),
                                         fromfile='expected statements', tofile='current statements'))
    if delta:
        print(delta, end='', flush=True)
        fail('the statements of the bridge\'s theorems changed; inspect the diff and explicitly update '
             f'{EXPECTED.relative_to(ROOT)}')


def check_closure():
    """The fact and not a spelling: what Lean itself imported to build the bridge."""
    print('      the proof-tree modules among everything the bridge imports, asked of Lean', flush=True)
    artifacts = ROOT / '.tmp' / 'c2-bridge-gate'
    artifacts.mkdir(parents=True, exist_ok=True)
    scratch = artifacts / 'imports.lean'
    scratch.write_text(f'import Lean\nimport {TARGET}\nopen Lean in\n#eval show CoreM Unit from do\n'
                       '  let names := (← getEnv).allImportedModuleNames\n'
                       '  IO.println s!"modules: {names.size}"\n'
                       '  for name in names do\n'
                       '    if (`Leanux.Proofs).isPrefixOf name then IO.println s!"proof tree: {name}"\n')
    result = subprocess.run(binary_gate.capped(['lake', 'env', 'lean', str(scratch)]), cwd=ROOT / 'binary',
                            capture_output=True, text=True)
    lines = [line for line in result.stdout.splitlines() if line.strip()]
    if result.returncode or result.stderr or not lines or not re.fullmatch(r'modules: [1-9]\d*', lines[0]) \
            or any(not line.startswith('proof tree: ') for line in lines[1:]):
        fail(f'listing the bridge\'s imports failed:\n{result.stdout}{result.stderr}')
        return
    reached = {line.removeprefix('proof tree: ') for line in lines[1:]}
    print(f'  {lines[0].removeprefix("modules: ")} modules imported; of the proof tree, {len(reached)}: '
          f'{", ".join(sorted(reached)[:8]) or "none"}{", ..." if len(reached) > 8 else ""}', flush=True)
    beyond = sorted(reached - BRIDGE_IMPORTS)
    if beyond:
        fail(f'the bridge reaches {len(beyond)} module(s) of the proof tree beyond the four: '
             + ', '.join(beyond[:5]) + (', ...' if len(beyond) > 5 else ''))
    for name in sorted(BRIDGE_IMPORTS - reached):
        fail(f'the bridge does not reach {name}: the claim would no longer rest on the landed theorems')


def check_source():
    print('[4/6] forbidden tokens in binary/bridge/', flush=True)
    files = sorted(BRIDGE_DIR.rglob('*.lean'))
    for path in files:
        if path != BRIDGE:
            fail(f'{path.relative_to(ROOT)}: binary/bridge/ holds a Lean file other than C2Bridge.lean')
    if BRIDGE not in files:
        fail(f'{BRIDGE.relative_to(ROOT)} is missing')
        return
    for path in files:
        for number, line in enumerate(binary_gate.strip_comments(path.read_text()).splitlines(), 1):
            for match in binary_gate.FORBIDDEN.finditer(line):
                fail(f'{path.relative_to(ROOT)}:{number}: {match.group(0)}')
    code = binary_gate.strip_comments(BRIDGE.read_text())
    declared = {'Binary.C2.Bridge.' + name for name in re.findall(r'^\s*(?:theorem|lemma)\s+(\S+)', code, re.M)}
    for name in sorted(declared ^ set(THEOREMS)):
        fail(f'{name}: the theorems of the bridge and the gate\'s list differ')

    print('[5/6] imports of the bridge, and the default targets', flush=True)
    package = {path.stem for path in (ROOT / 'binary').glob('*.lean')}
    imported = set()
    for number, line in enumerate(code.splitlines(), 1):
        if not re.match(r'^\s*((public|private|meta)\s+)*import\b', line):
            continue
        m = re.match(r'^import\s+(\S+)\s*$', line)
        if not m:
            fail(f'{BRIDGE.relative_to(ROOT)}:{number}: an import line the gate does not read: {line.strip()}')
        elif m.group(1) in BRIDGE_IMPORTS:
            imported.add(m.group(1))
        elif m.group(1) not in package:
            fail(f'{BRIDGE.relative_to(ROOT)}:{number}: imports {m.group(1)}, which is neither a module of the '
                 'binary package nor one of the four CounterWindow modules')
    for name in sorted(BRIDGE_IMPORTS - imported):
        fail(f'the bridge does not import {name}: the claim would no longer rest on the landed theorems')
    lakefile = (ROOT / 'binary' / 'lakefile.toml').read_text()
    m = re.search(r'^defaultTargets\s*=\s*\[([^\]]*)\]', lakefile, re.M)
    if not m:
        fail('binary/lakefile.toml has no defaultTargets line')
    elif f'"{TARGET}"' in m.group(1):
        fail(f'{TARGET} is a default lake target')


def check_lag():
    print('[6/6] lag report', flush=True)
    modules = ['Leanux/Proofs/WG/CounterWindow/' + name.rsplit('.', 1)[1] + '.lean' for name in sorted(BRIDGE_IMPORTS)]
    print(f'  the four CounterWindow modules last changed at: {git("log", "-1", "--format=%h", "--", *modules)}')
    print(f'  the mirror last changed at:                    {git("log", "-1", "--format=%h", "--", *MIRROR)}')
    rows = [line for line in REGISTER.read_text().splitlines() if line.startswith(ROW)]
    if len(rows) != 1:
        fail(f'{REGISTER.relative_to(ROOT)} has {len(rows)} rows starting "{ROW}", expected one')
        return
    cells = [cell.strip() for cell in rows[0].strip('|').split('|')]
    commit, status = cells[-2].strip('`'), cells[-1]
    print(f'  the register row names mirror commit:          {commit}')
    if not re.fullmatch(r'[0-9a-f]{7,40}', commit):
        fail(f'the register row names no mirror commit: {commit}')
        return
    changed = subprocess.run(['git', '-C', str(ROOT), 'diff', '--quiet', commit, 'HEAD', '--', *MIRROR]).returncode
    if changed not in (0, 1):
        fail(f'git cannot compare the mirror with {commit}')
        return
    current, lagging = status.startswith('Current'), status.startswith('Lagging')
    print(f'  mirror files differing from {commit}: {"some" if changed else "none"}; the row says: '
          f'{"Current" if current else "Lagging" if lagging else "neither"}')
    if not current and not lagging:
        fail('the register row\'s last cell must begin with "Current" or "Lagging"')
    if changed and current:
        fail(f'the mirror differs from {commit} but the register row says Current: it must say Lagging')


def main():
    if sys.argv[1:] not in ([], ['--write-expected']):
        raise SystemExit('usage: c2-bridge-gate [--write-expected]')
    if sys.argv[1:]:
        # Intentionally replace the reviewed statements, from the bridge as built; commit and review the diff.
        actual = render_statements()
        if actual is None:
            return 1
        EXPECTED.write_text(actual)
        print(f'Updated {EXPECTED}; review its Git diff')
        return 0
    sys.path.insert(0, str(ROOT / 'binary'))
    from pin import verify_pin
    print('[1/6] private Kraken pin and clean tree', flush=True)
    try:
        print(f'  {verify_pin(ROOT)}', flush=True)
    except (ValueError, OSError, subprocess.CalledProcessError) as exc:
        fail(str(exc))
    built = False
    if not failures:
        print(f'[2/6] lake -d binary build {TARGET}', flush=True)
        result = subprocess.run(binary_gate.capped(['lake', '-d', 'binary', 'build', TARGET]), cwd=ROOT,
                                capture_output=True, text=True)
        tail = [line for line in (result.stdout + result.stderr).splitlines() if line.strip()]
        print(f'  {tail[-1] if tail else "(no output)"}', flush=True)
        if result.returncode:
            print(result.stdout + result.stderr, file=sys.stderr, flush=True)
            fail(f'the bridge build exited {result.returncode}')
        else:
            built = True
        for line in tail:
            if line.startswith('warning:') and 'bridge/' in line:
                fail(f'the bridge build warns: {line}')
    if built:
        check_axioms()
        check_statements()
    check_source()
    if built:
        check_closure()
    check_lag()
    print('c2 bridge gate: ' + ('FAILED' if failures else 'PASS'), flush=True)
    return 1 if failures else 0


if __name__ == '__main__':
    sys.exit(main())
