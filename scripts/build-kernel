#!/bin/sh
# Run through scripts/in-bundle. Build a small KCOV-enabled oracle kernel.
# LEANUX_KERNEL_PROFILE=net adds networking and WireGuard (WireGuard plan, U1);
# its configuration is recorded as kernel/config-x86_64-net.
# LEANUX_KERNEL_PROFILE=net-rcov is the same configuration built from a copy of
# the locked source with kernel/patches/wireguard-kcov-remote.patch applied
# (WireGuard plan, U2): KCOV remote-coverage sections only, every line number
# preserved, and debug paths mapped back to .deps/linux.
# LEANUX_KERNEL_PROFILE=net-hidden adds kernel/patches/wireguard-hidden-inputs.patch
# on top (hidden-inputs design): kcov_record() and its hooks at WireGuard's
# random and clock sources, and a remote section for the handshake send worker.
set -eu
# The box-wide memory-cap wrapper (cgroup memory.max; see ~/.claude/CLAUDE.md).
# scripts/in-bundle's PATH has no /usr/local/bin, hence the absolute path.
CAPPED="${LEANUX_CAPPED:-/usr/local/bin/capped}"
[ -x "$CAPPED" ] || { echo "Memory-cap wrapper not found: $CAPPED (install capped, or point LEANUX_CAPPED at it)." >&2; exit 1; }
PROFILE="${LEANUX_KERNEL_PROFILE:-base}"
case "$PROFILE" in base|net|net-rcov|net-hidden|net-probe|net-choice|net-choice-actl) ;; *) echo "Unknown kernel profile: $PROFILE" >&2; exit 1 ;; esac
LEANUX_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
LEANUX_SHARED_ROOT="${LEANUX_SHARED_ROOT:-$LEANUX_ROOT}"
LEANUX_ARTIFACTS="${LEANUX_ARTIFACTS:-$LEANUX_ROOT/.artifacts}"
LEANUX_BUILD="${LEANUX_KERNEL_BUILD:-$LEANUX_ARTIFACTS/kernel}"
LEANUX_BUILD=$(realpath -m -- "$LEANUX_BUILD")
case "$LEANUX_BUILD/" in
    "$LEANUX_ARTIFACTS/"*) ;;
    *) echo 'Kernel build directory must be inside .artifacts.' >&2; exit 1 ;;
esac
mkdir -p "$LEANUX_BUILD"
SOURCE="$LEANUX_SHARED_ROOT/.deps/linux"
KCFLAGS_EXTRA=''
if [ "$PROFILE" = net-rcov ] || [ "$PROFILE" = net-hidden ] || [ "$PROFILE" = net-probe ] || [ "$PROFILE" = net-choice ] || [ "$PROFILE" = net-choice-actl ]; then
    PATCH="$LEANUX_ROOT/kernel/patches/wireguard-kcov-remote.patch"
    PATCH_SHA=503c899d061530af6d250ed018466b7ba1cc77407f3a3492edf031e20d9cfe07
    SOURCE="$LEANUX_ARTIFACTS/src/linux-6.12.110-wireguard-kcov-remote"
    HIDDEN_PATCH="$LEANUX_ROOT/kernel/patches/wireguard-hidden-inputs.patch"
    HIDDEN_SHA=91a412bad138e2f5d765ca5653dd874e4618658c081b3212a87894f93220cf0b
    # net-probe: a throwaway measurement kernel (choice-stream strategy,
    # section 10 step 0), never an oracle
    PROBE_PATCH="$LEANUX_ROOT/kernel/patches/probe-choice-enumeration.patch"
    PROBE_SHA=8205bdbaf48dfba17234aa8a95440b8f435f151dd42003f070b88d2ea228f41f
    # net-choice: generic choice capture (choice-stream strategy, step 1),
    # replacing the hidden-inputs patch's per-site hooks
    CHOICE_PATCH="$LEANUX_ROOT/kernel/patches/choice-stream.patch"
    # (generated by kernel/patches/gen-choice-stream.py); since the D1 sprint
    # it also carries the dispatch sections and applies alone, retiring
    # wireguard-kcov-remote.patch's per-site sections for this profile; since
    # D3 (docs/2026-10-05-d3-timers.md) also timer sections, the arm record and
    # the virtual time advance; since A (docs/2026-10-05-a-alloc.md) the
    # allocation hook in mm/slub.c and mm/page_alloc.c; since the D3+A
    # integration the irqs-off time advance and KCOV_DISPATCH_MAX 32
    CHOICE_SHA=4274afa340f5fe7f9178eca8ab56d2e0b8278fa63e734d8e9adda2ba53a4edf0
    # net-choice-actl: the allocation-steering control kernel (A, section 7:
    # K1, K4, K5), the same patch with control load flags; never an oracle
    ACTL_PATCH="$LEANUX_ROOT/kernel/patches/choice-stream-alloc-controls.patch"
    ACTL_SHA=8dd6fffee734cbdc35942d21e99dd269ebd18a6879a39e2d00b5fdbf2915671b
    if [ "$PROFILE" = net-choice ]; then
        SOURCE="$LEANUX_ARTIFACTS/src/linux-6.12.110-choice-stream-da"
        PATCH_SHA_RECORD="$CHOICE_SHA"
    elif [ "$PROFILE" = net-choice-actl ]; then
        SOURCE="$LEANUX_ARTIFACTS/src/linux-6.12.110-choice-stream-da-controls"
        PATCH_SHA_RECORD="$ACTL_SHA"
    elif [ "$PROFILE" = net-probe ]; then
        SOURCE="$LEANUX_ARTIFACTS/src/linux-6.12.110-probe-choice-enumeration"
        PATCH_SHA_RECORD="$PATCH_SHA $HIDDEN_SHA $PROBE_SHA"
    elif [ "$PROFILE" = net-hidden ]; then
        SOURCE="$LEANUX_ARTIFACTS/src/linux-6.12.110-wireguard-hidden-inputs"
        PATCH_SHA_RECORD="$PATCH_SHA $HIDDEN_SHA"
    else
        PATCH_SHA_RECORD="$PATCH_SHA"
    fi
    if [ -e "$SOURCE/.leanux-patch-sha256" ]; then
        [ "$(cat "$SOURCE/.leanux-patch-sha256")" = "$PATCH_SHA_RECORD" ] || {
            echo "Patched source exists with a different patch: $SOURCE" >&2
            exit 1
        }
    else
        ARCHIVE="$LEANUX_SHARED_ROOT/.deps/downloads/linux-6.12.110.tar.xz"
        LOCKED=$(python3 -c "import json,sys; print(next(e['sha256'] for e in json.load(open(sys.argv[1])) if e['name'] == 'linux'))" \
            "$LEANUX_SHARED_ROOT/dependencies/sources.lock.json")
        [ "$(sha256sum "$ARCHIVE" | cut -d' ' -f1)" = "$LOCKED" ] || {
            echo "Linux archive differs from the lock" >&2
            exit 1
        }
        rm -rf "$SOURCE.extracting"
        mkdir -p "$SOURCE.extracting"
        tar -xJf "$ARCHIVE" -C "$SOURCE.extracting" --strip-components=1
        if [ "$PROFILE" != net-choice ] && [ "$PROFILE" != net-choice-actl ]; then
            python3 "$LEANUX_ROOT/scripts/apply-kernel-patch.py" "$PATCH" "$SOURCE.extracting" "$PATCH_SHA"
        fi
        if [ "$PROFILE" = net-hidden ] || [ "$PROFILE" = net-probe ]; then
            python3 "$LEANUX_ROOT/scripts/apply-kernel-patch.py" "$HIDDEN_PATCH" "$SOURCE.extracting" "$HIDDEN_SHA"
        fi
        if [ "$PROFILE" = net-probe ]; then
            python3 "$LEANUX_ROOT/scripts/apply-kernel-patch.py" "$PROBE_PATCH" "$SOURCE.extracting" "$PROBE_SHA"
        fi
        if [ "$PROFILE" = net-choice ]; then
            python3 "$LEANUX_ROOT/scripts/apply-kernel-patch.py" "$CHOICE_PATCH" "$SOURCE.extracting" "$CHOICE_SHA"
        fi
        if [ "$PROFILE" = net-choice-actl ]; then
            python3 "$LEANUX_ROOT/scripts/apply-kernel-patch.py" "$ACTL_PATCH" "$SOURCE.extracting" "$ACTL_SHA"
        fi
        echo "$PATCH_SHA_RECORD" > "$SOURCE.extracting/.leanux-patch-sha256"
        mv "$SOURCE.extracting" "$SOURCE"
    fi
    KCFLAGS_EXTRA="-fdebug-prefix-map=$SOURCE=$LEANUX_SHARED_ROOT/.deps/linux"
fi
export KBUILD_BUILD_USER=leanux KBUILD_BUILD_HOST=offline KBUILD_BUILD_VERSION=1
export KBUILD_BUILD_TIMESTAMP='2026-09-20 00:00:00 UTC'
make -s -C "$SOURCE" O="$LEANUX_BUILD" ARCH=x86_64 allnoconfig
LEANUX_CONFIG="$SOURCE/scripts/config"
for option in 64BIT BINFMT_ELF BINFMT_SCRIPT PRINTK BUG MULTIUSER POSIX_TIMERS FUTEX \
    EVENTFD EPOLL SIGNALFD TIMERFD SHMEM TMPFS PROC_FS SYSFS \
    BLK_DEV_INITRD RD_GZIP DEVTMPFS DEVTMPFS_MOUNT TTY \
    SERIAL_8250 SERIAL_8250_CONSOLE DEBUG_KERNEL DEBUG_FS \
    DEBUG_INFO_DWARF4 KALLSYMS KCOV KCOV_INSTRUMENT_ALL \
    KCOV_ENABLE_COMPARISONS; do
    "$LEANUX_CONFIG" --file "$LEANUX_BUILD/.config" --enable "$option"
done
if [ "$PROFILE" != base ]; then
    # WIREGUARD selects the x86-64 crypto implementations (CRYPTO_CURVE25519_X86 etc.).
    for option in NET UNIX INET IPV6 NET_NS NETDEVICES NET_CORE VETH WIREGUARD; do
        "$LEANUX_CONFIG" --file "$LEANUX_BUILD/.config" --enable "$option"
    done
fi
for option in MODULES SMP RANDOMIZE_BASE DEBUG_INFO_NONE LOCALVERSION_AUTO; do
    "$LEANUX_CONFIG" --file "$LEANUX_BUILD/.config" --disable "$option"
done
SUFFIX='-leanux-kcov'; [ "$PROFILE" = net ] && SUFFIX='-leanux-kcov-net'
[ "$PROFILE" = net-rcov ] && SUFFIX='-leanux-kcov-net-rcov'
[ "$PROFILE" = net-hidden ] && SUFFIX='-leanux-kcov-net-hidden'
[ "$PROFILE" = net-probe ] && SUFFIX='-leanux-kcov-net-probe'
[ "$PROFILE" = net-choice ] && SUFFIX='-leanux-kcov-net-choice'
[ "$PROFILE" = net-choice-actl ] && SUFFIX='-leanux-kcov-net-choice-actl'
"$LEANUX_CONFIG" --file "$LEANUX_BUILD/.config" --set-str LOCALVERSION "$SUFFIX"
make -s -C "$SOURCE" O="$LEANUX_BUILD" ARCH=x86_64 olddefconfig
REQUIRED="64BIT BINFMT_ELF BINFMT_SCRIPT EVENTFD BLK_DEV_INITRD SERIAL_8250_CONSOLE DEBUG_FS DEBUG_INFO_DWARF4 KCOV"
[ "$PROFILE" != base ] && REQUIRED="$REQUIRED NET INET IPV6 NET_NS VETH WIREGUARD"
for option in $REQUIRED; do
    grep -qx "CONFIG_${option}=y" "$LEANUX_BUILD/.config" || {
        echo "Required kernel configuration did not resolve: $option" >&2
        exit 1
    }
done
"$CAPPED" -- make -C "$SOURCE" O="$LEANUX_BUILD" ARCH=x86_64 KCFLAGS="$KCFLAGS_EXTRA" \
    -j"${LEANUX_JOBS:-4}" bzImage vmlinux
mkdir -p "$LEANUX_ROOT/kernel"
if [ "$PROFILE" = net-choice ]; then
    cp "$LEANUX_BUILD/.config" "$LEANUX_ROOT/kernel/config-x86_64-net-choice"
elif [ "$PROFILE" = net-probe ] || [ "$PROFILE" = net-choice-actl ]; then
    :   # a probe or control kernel records no configuration
elif [ "$PROFILE" = net-hidden ]; then
    cp "$LEANUX_BUILD/.config" "$LEANUX_ROOT/kernel/config-x86_64-net-hidden"
elif [ "$PROFILE" = net-rcov ]; then
    cp "$LEANUX_BUILD/.config" "$LEANUX_ROOT/kernel/config-x86_64-net-rcov"
elif [ "$PROFILE" = net ]; then
    cp "$LEANUX_BUILD/.config" "$LEANUX_ROOT/kernel/config-x86_64-net"
else
    cp "$LEANUX_BUILD/.config" "$LEANUX_ROOT/kernel/config-x86_64"
fi
