#!/bin/sh
# Run via scripts/in-bundle. The sources and complete Go module cache are staged.
set -eu
LEANUX_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
if [ "${LEANUX_SHARED_ROOT:-$LEANUX_ROOT}" != "$LEANUX_ROOT" ]; then
    echo 'Shared syzkaller maintenance must run in the coordinator checkout.' >&2
    exit 1
fi
if [ ! -d "$LEANUX_ROOT/.deps/go-mod" ]; then
    echo 'Missing staged offline Go module store (.deps/go-mod).' >&2
    exit 1
fi
cd "$LEANUX_ROOT/.deps/syzkaller"
# Archive checkouts have no Git metadata: provide the upstream revision explicitly.
# Keep make serial; Go itself uses the launcher's GOMAXPROCS=4 budget.
make -j1 NCORES=1 SYZ_ENV=1 \
    'GOHOSTFLAGS=-buildvcs=false $(GOFLAGS)' \
    'GOTARGETFLAGS=-buildvcs=false $(GOFLAGS)' \
    REV=853b104bb454141a5b0fc0e4218ec78e9f34ffb1 GITREVDATE=20260918-062331 \
    manager execprog executor mutate prog2c repro db
go mod verify
